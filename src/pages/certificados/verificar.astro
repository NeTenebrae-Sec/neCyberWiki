---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { site } from "../../data/site"

const base = site.base
---

<BaseLayout
  titulo="Verificar certificado"
  descripcion="Página pública para verificar códigos de certificados emitidos por neCyberWiki."
>
  <section class="verify container-page">
    <div class="verify__docket">
      <span class="docket">Certificados verificables</span>
      <span class="stamp">Fase 2</span>
    </div>

    <div class="verify__grid">
      <div>
        <h1 class="verify__title">Sello pendiente.</h1>
        <p class="lead verify__lead">
          La emisión y verificación de certificados llega en la fase 2 del proyecto: un PDF generado
          en tu navegador con un código único. Mientras tanto, terminar un curso te da progreso
          local y aprendizaje, sin datos personales.
        </p>

        <p class="verify__note">
          Ejemplo de código futuro:
          <code>NCW-ARCH-2026-A7F3K9</code>. No hay certificados emitidos todavía, así que ningún
          código es válido hoy.
        </p>

        <a class="btn btn-secondary verify__cta" href={`${base}cursos/arch-linux-facil/`}>
          Continuar el curso <span aria-hidden="true">→</span>
        </a>
      </div>

      <form class="verify-form sheet sheet--cut" aria-labelledby="verify-form-title">
        <span class="tape verify-form__tape" aria-hidden="true"></span>

        <h2 id="verify-form-title" class="verify-form__title">
          Verificar un código
        </h2>
        <p class="verify-form__hint" id="verify-hint">
          El formulario se activará cuando existan certificados emitidos.
        </p>

        <fieldset class="verify-form__fieldset" disabled aria-describedby="verify-hint">
          <legend class="sr-only">Datos del certificado</legend>

          <div class="field">
            <label for="codigo">Código del certificado</label>
            <input
              type="text"
              id="codigo"
              name="codigo"
              class="input"
              placeholder="NCW-ARCH-2026-XXXXXX"
              autocomplete="off"
              spellcheck="false"
              inputmode="text"
            />
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Verificar sello
          </button>
        </fieldset>

        <p class="verify-form__foot">
          Sin cuentas, sin correos. El certificado solo demuestra que completaste el curso.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .verify {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 7vw, 6rem);
  }

  .verify__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1rem;
    margin-bottom: 1.25rem;
  }

  .verify__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .verify__title {
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .verify__lead {
    margin-top: 1.1rem;
    max-width: 54ch;
  }

  .verify__note {
    margin-top: 1.1rem;
    max-width: 60ch;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .verify__note code {
    padding: 0.15em 0.4em;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    color: var(--accent);
    font-size: 0.82em;
  }

  .verify__cta {
    margin-top: 1.5rem;
  }

  .verify-form {
    --sheet-cut: 26px;
    position: relative;
    padding: 1.4rem;
    background: var(--bg-raised);
  }

  .verify-form__tape {
    top: -0.55rem;
    right: 2rem;
    width: 4.5rem;
    transform: rotate(3deg);
  }

  .verify-form__title {
    font-size: 1.35rem;
    letter-spacing: -0.025em;
  }

  .verify-form__hint {
    margin-top: 0.4rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.55;
  }

  .verify-form__fieldset {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 0;
    border: 0;
    opacity: 0.62;
  }

  .verify-form__foot {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  @media (max-width: 800px) {
    .verify__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .verify-form {
      max-width: 32rem;
    }
  }
</style>

      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .route-groups {
      height: 43rem;
    }

    .route-groups:not(.is-detail) {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-row__side {
      align-items: flex-end;
      flex-direction: column;
    }

    .post-row__tags {

---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import CourseCard from "../components/CourseCard.astro"
import { getCategoriasConContenido, getCursosPublicados, leccionUrl } from "../lib/catalog"
import { site } from "../data/site"

const base = site.base
const cursos = await getCursosPublicados()
const categorias = await getCategoriasConContenido()
const disponibles = categorias.filter((categoria) => categoria.disponible)
const preparacion = categorias.filter((categoria) => !categoria.disponible)
const destacado = cursos[0]
const primeraLeccion = destacado?.lecciones[0]
const empezarUrl =
  destacado && primeraLeccion ? leccionUrl(destacado, primeraLeccion, base) : `${base}cursos/`
const totalLecciones = cursos.reduce((total, curso) => total + curso.lecciones.length, 0)

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
const fecha = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date)
---

<BaseLayout
  titulo="Archivo personal de aprendizaje"
  descripcion="Cursos, laboratorios y bitácora sobre Linux, redes y ciberseguridad en español. Sin cuentas, sin backend y con el progreso guardado en tu navegador."
>
  <section class="home-hero">
    <div class="container-page home-hero__grid">
      <div class="home-hero__copy">
        <div class="hero-docket">
          <span class="docket">Archivo del Abismo</span>
          <span class="stamp">Aprendizaje abierto</span>
        </div>

        <h1 class="display home-hero__title">
          Aprende a <em>leer</em> el sistema antes de auditarlo.
        </h1>

        <p class="lead home-hero__lead">
          Un archivo personal de cursos y notas de campo sobre Linux, redes y ciberseguridad. Todo
          en español, sin cuentas y con tu avance guardado en el navegador.
        </p>

        <div class="home-hero__actions">
          <a class="btn btn-primary btn-lg" href={`${base}cursos/`}>
            Explorar los cursos <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-secondary btn-lg" href={`${base}blog/`}>
            Leer la bitácora
          </a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Cursos publicados</dt>
            <dd>{String(cursos.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Lecciones</dt>
            <dd>{String(totalLecciones).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Rutas abiertas</dt>
            <dd>
              {String(disponibles.length).padStart(2, "0")} <span>/ {categorias.length}</span>
            </dd>
          </div>
        </dl>
      </div>

      {destacado && (
        <aside class="dossier-cover sheet sheet--cut" aria-labelledby="course-card-title">
          <span class="tape dossier-cover__tape" aria-hidden="true"></span>

          <div class="dossier-cover__top">
            <span class="docket">Último curso publicado</span>
            <span class="stamp stamp--straight">{destacado.nivel}</span>
          </div>

          <h2 id="course-card-title" class="dossier-cover__title">
            {destacado.titulo}
          </h2>
          <p class="dossier-cover__desc">{destacado.promesa}</p>

          <ol class="dossier-cover__modules" aria-label="Módulos del curso">
            {destacado.modulos.map((modulo) => (
              <li>
                <span class="dossier-cover__mod-num">{String(modulo.numero).padStart(2, "0")}</span>
                <span class="dossier-cover__mod-title">{modulo.titulo}</span>
                <span class="dossier-cover__mod-count">{modulo.count}</span>
              </li>
            ))}
          </ol>

          <div class="dossier-cover__meta">
            <span>
              {destacado.lecciones.length} {destacado.unidad === "nivel" ? "niveles" : "lecciones"}
            </span>
            <span>{destacado.modulos.length} módulos</span>
            <span>Guía escrita</span>
          </div>

          <div
            class="dossier-cover__progress"
            data-course-progress={destacado.slug}
            data-total={destacado.lecciones.length}
            data-unidad={destacado.unidad === "nivel" ? "niveles" : "lecciones"}
          >
            <div class="progress-head">
              <span>Tu avance</span>
              <strong data-course-progress-label>0 / {destacado.lecciones.length}</strong>
            </div>
            <div class="progress-track" role="progressbar" aria-label="Progreso del curso">
              <div class="progress-fill" data-course-progress-fill></div>
            </div>
          </div>

          <a class="dossier-cover__link" href={empezarUrl}>
            <span>Empezar el curso</span>
            <span aria-hidden="true">→</span>
          </a>
        </aside>
      )}
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">01 / Cursos</p>
          <h2 class="home-section__title">Lo que ya se puede estudiar.</h2>
        </div>
        <a class="arrow-link" href={`${base}cursos/`}>
          Ver el catálogo completo <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="course-grid">
        {cursos.map((curso) => (
          <CourseCard curso={curso} variant="compact" />
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page home-routes">
      <div>
        <p class="running-head">02 / Rutas</p>
        <h2 class="home-section__title">Ocho rutas. Una encendida.</h2>
        <p class="home-section__lead">
          Las categorías ordenan el archivo, pero no todas tienen contenido. Las apagadas siguen
          visibles para que sepas qué falta, sin fechas inventadas.
        </p>
      </div>

      <div>
        <ul class="route-list">
          {disponibles.map((categoria) => (
            <li class="route-row">
              <a href={`${base}cursos/${categoria.id}/`}>
                <span class="route-row__num">{categoria.indice}</span>
                <span class="route-row__main">
                  <span class="route-row__title">{categoria.titulo}</span>
                  <span class="route-row__detail">
                    {categoria.cursos.length} {categoria.cursos.length === 1 ? "curso" : "cursos"} ·{" "}
                    {categoria.totalLecciones} lecciones
                  </span>
                </span>
                <span class="route-row__state route-row__state--open">Abierta</span>
                <span class="route-row__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
          {preparacion.map((categoria) => (
            <li class="route-row route-row--pending">
              <a href={`${base}cursos/${categoria.id}/`}>
                <span class="route-row__num">{categoria.indice}</span>
                <span class="route-row__main">
                  <span class="route-row__title">{categoria.titulo}</span>
                  <span class="route-row__detail">{categoria.tagline}</span>
                </span>
                <span class="route-row__state">En preparación</span>
                <span class="route-row__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">03 / Bitácora</p>
          <h2 class="home-section__title">Lo último que salió del laboratorio.</h2>
        </div>
        <a class="arrow-link" href={`${base}blog/`}>
          Ver toda la bitácora <span aria-hidden="true">→</span>
        </a>
      </div>

      {posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => {
            const slug = post.id.split("/").pop()
            return (
              <li>
                <a class="post-row" href={`${base}blog/${slug}/`}>
                  <time class="post-row__date" datetime={post.data.date.toISOString()}>
                    {fecha(post.data.date)}
                  </time>
                  <span class="post-row__main">
                    <span class="post-row__title">{post.data.title}</span>
                    <span class="post-row__desc">{post.data.description}</span>
                  </span>
                  <span class="post-row__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      ) : (
        <p class="home-section__empty sheet sheet--flat">
          Todavía no hay entradas publicadas. Cuando haya algo que no justifique un curso, aparecerá
          aquí.
        </p>
      )}
    </div>
  </section>

  <section class="home-section home-section--support">
    <div class="container-page support-grid">
      <div>
        <p class="running-head">04 / Apoyo</p>
        <h2 class="home-section__title">Gratis para aprender.</h2>
        <p class="home-section__lead">
          El archivo no tiene muro de pago ni cuentas. Si te sirve, puedes invitar un café para
          mantener el laboratorio y el tiempo de escritura.
        </p>
        <a class="btn btn-primary" href={site.koFi} target="_blank" rel="noopener">
          Apoyar en Ko-fi <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="support-note sheet sheet--flat">
        <p class="docket">Regla de campo</p>
        <h3>El permiso no es opcional.</h3>
        <p>
          Todo lo que se enseña aquí se practica en máquinas propias o en laboratorios con
          autorización. Fuera de ahí, no es auditoría: es delito.
        </p>
        <a class="arrow-link" href={`${base}terminos/`}>
          Leer los términos <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(2.75rem, 6vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.1rem;
    margin-bottom: 1.5rem;
  }

  .home-hero__title {
    max-width: 13ch;
    font-size: clamp(2.55rem, 5.6vw, 5.15rem);
    line-height: 0.92;
  }

  .home-hero__title em {
    color: var(--stamp);
    font-style: italic;
  }

  .home-hero__lead {
    margin-top: 1.6rem;
    max-width: 52ch;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: 2.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .hero-facts > div {
    padding-right: 1.5rem;
  }

  .hero-facts > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero-facts dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-facts dd span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .dossier-cover {
    --sheet-cut: 30px;
    position: relative;
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--bg-raised);
  }

  .dossier-cover__tape {
    top: -0.55rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .dossier-cover__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .dossier-cover__title {
    margin-top: 1rem;
    font-size: clamp(1.65rem, 2.5vw, 2.15rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .dossier-cover__desc {
    margin-top: 0.65rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .dossier-cover__modules {
    margin-top: 1.1rem;
    border-top: 1px solid var(--line);
    list-style: none;
    padding: 0;
  }

  .dossier-cover__modules li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--line);
  }

  .dossier-cover__mod-num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--accent);
  }

  .dossier-cover__mod-title {
    color: var(--ink);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .dossier-cover__mod-count {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-muted);
  }

  .dossier-cover__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-muted);
  }

  .dossier-cover__progress {
    padding-block: 0.85rem 0.2rem;
  }

  .dossier-cover__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .dossier-cover__link span:last-child {
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .dossier-cover__link:hover span:last-child {
    transform: translateX(3px);
  }

  .home-section {
    padding-block: clamp(3rem, 6.5vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }

  .home-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .running-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .running-head::after {
    content: "";
    width: 2rem;
    height: 1px;
    flex-shrink: 0;
    background: var(--line-strong);
  }

  .home-section__title {
    margin-top: 0.8rem;
    font-size: clamp(1.9rem, 3vw, 2.85rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .home-section__lead {
    margin-top: 0.9rem;
    max-width: 44ch;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-routes,
  .support-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    align-items: start;
  }

  .route-list {
    border-top: 1px solid var(--line-strong);
    list-style: none;
    padding: 0;
  }

  .route-row + .route-row {
    border-top: 1px solid var(--line);
  }

  .route-row a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto 1rem;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.85rem;
    text-decoration: none;
  }

  .route-row__num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
  }

  .route-row__title {
    display: block;
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .route-row__detail {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink-dim);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .route-row__state {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .route-row__state--open {
    color: var(--signal);
  }

  .route-row__arrow {
    color: var(--accent);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .route-row a:hover .route-row__title {
    color: var(--accent);
  }

  .route-row a:hover .route-row__arrow {
    transform: translateX(3px);
  }

  .route-row--pending {
    opacity: 0.78;
  }

  .post-list {
    border-top: 1px solid var(--line-strong);
    list-style: none;
    padding: 0;
  }

  .post-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 1rem;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .post-row__date {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .post-row__title {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .post-row__desc {
    display: block;
    margin-top: 0.2rem;
    color: var(--ink-dim);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .post-row__arrow {
    color: var(--accent);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .post-row:hover .post-row__title {
    color: var(--accent);
  }

  .post-row:hover .post-row__arrow {
    transform: translateX(3px);
  }

  .home-section__empty {
    padding: 1.2rem;
    color: var(--ink-dim);
  }

  .home-section--support {
    background: var(--bg-sunken);
  }

  .support-note {
    padding: 1.2rem 1.3rem;
    border-left: 3px solid var(--danger);
  }

  .support-note h3 {
    margin-top: 0.6rem;
    font-size: 1.35rem;
    letter-spacing: -0.025em;
  }

  .support-note p {
    margin-top: 0.6rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .support-note .arrow-link {
    margin-top: 0.9rem;
  }

  @media (max-width: 960px) {
    .home-hero__grid,
    .home-routes,
    .support-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .dossier-cover {
      max-width: 34rem;
    }
  }

  @media (max-width: 720px) {
    .course-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr) 1rem;
      gap: 0.35rem 0.75rem;
    }

    .post-row__date {
      grid-column: 1;
      grid-row: 2;
    }

    .post-row__arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .route-row a {
      grid-template-columns: 1.6rem minmax(0, 1fr) 1rem;
    }

    .route-row__state {
      grid-column: 2;
      grid-row: 2;
    }

    .route-row__arrow {
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }

  @media (max-width: 420px) {
    .hero-facts {
      gap: 0.75rem 0;
    }

    .hero-facts > div {
      width: 100%;
      padding-right: 0;
    }

    .hero-facts > div + div {
      padding-left: 0;
      border-left: 0;
    }

    .dossier-cover {
      padding: 1.1rem;
    }

    .dossier-cover__modules li {
      grid-template-columns: 1.7rem minmax(0, 1fr) auto;
    }

    .home-hero__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

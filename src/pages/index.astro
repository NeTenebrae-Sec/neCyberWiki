<script>
  const accordion = document.querySelector("[data-route-accordion]")

  accordion?.querySelectorAll(".route-group").forEach((group) => {
    const trigger = group.querySelector(".route-group__trigger")
    const back = group.querySelector("[data-route-back]")
    if (!(trigger instanceof HTMLButtonElement)) return

    trigger.addEventListener("click", () => {
      accordion.classList.add("is-detail")
      accordion.querySelectorAll(".route-group").forEach((candidate) => {
        const candidateTrigger = candidate.querySelector(".route-group__trigger")
        const panel = candidate.querySelector(".route-group__panel")
        const isSelected = candidate === group
        candidate.classList.toggle("is-selected", isSelected)
        candidateTrigger?.setAttribute("aria-expanded", String(isSelected))
        if (panel instanceof HTMLElement) panel.hidden = !isSelected
      })
      if (back instanceof HTMLButtonElement) back.focus()
    })

    if (back instanceof HTMLButtonElement) {
      back.addEventListener("click", () => {
        accordion.classList.remove("is-detail")
        accordion.querySelectorAll(".route-group").forEach((candidate) => {
          candidate.classList.remove("is-selected")
          candidate.querySelector(".route-group__trigger")?.setAttribute("aria-expanded", "false")
          const panel = candidate.querySelector(".route-group__panel")
          if (panel instanceof HTMLElement) panel.hidden = true
        })
        trigger.focus()
      })
    }
  })
</script>

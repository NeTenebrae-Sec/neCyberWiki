---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import CircuitMap from "../components/home/CircuitMap.astro"
import { site } from "../data/site"
import { getCurso } from "../data/cursos"
import { CATEGORIAS } from "../data/categorias"
import { formatTotalMin, groupSyllabus, normalizeLesson, totalSyllabusMin } from "../lib/syllabus"

const base = site.base
const cursoArch = getCurso("arch-linux-facil")!

const lecciones = (
  await getCollection("cursos", ({ data }) => data.curso === cursoArch.slug && !data.draft)
)
  .map((leccion) => normalizeLesson(leccion.id, leccion.data))
  .sort((a, b) => a.orden - b.orden)

const modulosCurso = groupSyllabus(lecciones)
const duracionTotal = formatTotalMin(totalSyllabusMin(modulosCurso))
const cursoUrl = `${base}cursos/${cursoArch.slug}/`
const primeraLeccion = lecciones[0]
const primeraLeccionUrl = primeraLeccion
  ? `${base}cursos/${cursoArch.slug}/${primeraLeccion.slug}/`
  : cursoUrl

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
const ultimoPost = posts[0]
const ultimoPostSlug = ultimoPost?.id.split("/").pop()
const fecha = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", { year: "numeric", month: "long", day: "numeric" }).format(date)

const modulosActivos = CATEGORIAS.filter((categoria) => categoria.estado === "activo").length
const entradasDisponibles = CATEGORIAS.reduce(
  (total, categoria) =>
    total + categoria.recursos.filter((recurso) => recurso.estado === "disponible").length,
  0,
)
const tipoLabel: Record<string, string> = {
  curso: "Curso",
  writeup: "Writeup",
  guia: "Guía",
  articulo: "Artículo",
}
const lessonData = lecciones.map((leccion) => ({
  slug: leccion.slug,
  title: leccion.title,
  href: `${base}cursos/${cursoArch.slug}/${leccion.slug}/`,
}))
---

<BaseLayout
  titulo="Inicio · Aprende Linux y ciberseguridad"
  descripcion="Cursos, laboratorios y notas de campo sobre Linux, redes y seguridad web en español. Sin cuentas y con el progreso guardado en tu navegador."
>
  <section class="home-hero">
    <div class="hero-traces" aria-hidden="true"></div>
    <div class="container-page home-hero__grid">
      <div class="home-hero__copy">
        <div class="hero-docket">
          <span class="docket">
            Expediente 01 <span aria-hidden="true">/</span> 2026
          </span>
          <span class="stamp">Manual de campo</span>
        </div>

        <h1 class="display home-hero__title">
          Aprende a <em>leer</em> el sistema antes de auditarlo.
        </h1>

        <p class="lead home-hero__lead">
          Cursos, laboratorios y notas de campo sobre Linux, redes y seguridad web. Todo en español,
          sin cuentas y con tu avance guardado en el navegador.
        </p>

        <div class="home-hero__actions">
          <a class="btn btn-primary btn-lg" href={primeraLeccionUrl}>
            Empezar con Arch Linux <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-secondary btn-lg" href="#mapa">
            Ver los 8 sectores <span aria-hidden="true">↓</span>
          </a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Módulos</dt>
            <dd>
              {CATEGORIAS.length}
              <span> / {modulosActivos} activos</span>
            </dd>
          </div>
          <div>
            <dt>Entradas</dt>
            <dd>
              {entradasDisponibles}
              <span> disponibles</span>
            </dd>
          </div>
          <div>
            <dt>Progreso</dt>
            <dd>
              Local<span> · sin cuentas</span>
            </dd>
          </div>
        </dl>
      </div>

      <aside class="dossier-cover sheet sheet--cut" aria-labelledby="course-card-title">
        <span class="tape dossier-cover__tape" aria-hidden="true"></span>

        <div class="dossier-cover__top">
          <span class="docket">
            Curso 01 · <strong>Publicado</strong>
          </span>
          <span class="stamp stamp--straight">Arch Linux</span>
        </div>

        <h2 id="course-card-title" class="dossier-cover__title">
          Cómo instalar Arch Linux
        </h2>
        <p class="dossier-cover__desc">{cursoArch.promesa}</p>

        <ol class="dossier-cover__modules" aria-label="Módulos del curso">
          {modulosCurso.map((modulo) => (
            <li>
              <span class="dossier-cover__mod-num">{String(modulo.numero).padStart(2, "0")}</span>
              <span class="dossier-cover__mod-title">{modulo.titulo}</span>
              <span class="dossier-cover__mod-count">{modulo.count}</span>
            </li>
          ))}
        </ol>

        <div class="dossier-cover__meta">
          <span>{lecciones.length} lecciones</span>
          <span>{duracionTotal} de video</span>
          <span>8 módulos</span>
        </div>

        <div class="dossier-cover__progress">
          <div class="progress-head">
            <span>Tu avance</span>
            <strong id="hero-progress-label">0 / {lecciones.length}</strong>
          </div>
          <div
            id="hero-progress"
            class="progress-track"
            role="progressbar"
            aria-label="Progreso del curso Arch Linux fácil"
            aria-valuemin="0"
            aria-valuemax={lecciones.length}
            aria-valuenow="0"
          >
            <div id="hero-progress-fill" class="progress-fill"></div>
          </div>
        </div>

        <a
          id="home-continue"
          class="dossier-cover__link"
          href={primeraLeccionUrl}
          data-course-href={cursoUrl}
        >
          <span id="home-continue-text">Empezar el curso</span>
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <section id="mapa" class="home-section">
    <div class="container-page home-section__grid">
      <div class="home-section__aside">
        <p class="running-head">01 / Mapa de sectores</p>
        <h2 class="home-section__title">Ocho sectores. Un orden posible.</h2>
        <p class="home-section__lead">
          Cada nodo abre el expediente de un módulo: qué está publicado, qué viene después y en qué
          orden conviene estudiarlo. No hay una ruta única; hay una secuencia recomendada.
        </p>
        <p class="map-hint">
          <span class="status-dot status-dot--cyan" aria-hidden="true"></span>
          Selecciona un nodo o abre el índice completo. Todo funciona sin JavaScript.
        </p>
      </div>

      <div class="home-section__body">
        <CircuitMap categorias={CATEGORIAS} />

        <div id="modulos" class="module-index">
          {CATEGORIAS.map((categoria) => (
            <details
              class="module-entry"
              id={`mod-${categoria.indice}`}
              data-state={categoria.estado}
            >
              <summary class="module-entry__summary">
                <span class="module-entry__num">{categoria.indice}</span>
                <span class="module-entry__main">
                  <span class="module-entry__title">{categoria.titulo}</span>
                  <span class="module-entry__tagline">{categoria.tagline}</span>
                </span>
                <span class="module-entry__meta">
                  <span class="module-entry__level">{categoria.nivel}</span>
                  <span
                    class:list={[
                      "status",
                      categoria.estado === "activo" ? "status--active" : "status--pending",
                    ]}
                  >
                    <span
                      class:list={[
                        "status-dot",
                        categoria.estado === "activo" ? "" : "status-dot--amber",
                      ]}
                      aria-hidden="true"
                    />
                    {categoria.estado === "activo" ? "Activo" : "En preparación"}
                  </span>
                </span>
                <span class="module-entry__icon" aria-hidden="true"></span>
              </summary>

              <div class="module-entry__body">
                <div class="module-entry__desc">
                  <p>{categoria.descripcion}</p>
                  <ul class="tags module-entry__tags" aria-label="Temas clave">
                    {categoria.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                </div>

                <div class="module-entry__resources">
                  <p class="module-entry__resources-head">Entradas del módulo</p>
                  <ul>
                    {categoria.recursos.map((recurso) => {
                      const href = recurso.enlace ? `${base}${recurso.enlace}` : null
                      return (
                        <li class="resource-row">
                          <span class="resource-row__type">
                            {tipoLabel[recurso.tipo] ?? recurso.tipo}
                          </span>
                          <span class="resource-row__main">
                            <span class="resource-row__title">{recurso.titulo}</span>
                            {recurso.detalle && (
                              <span class="resource-row__detail">{recurso.detalle}</span>
                            )}
                          </span>
                          <span class="resource-row__action">
                            {href ? (
                              <a href={href} aria-label={`Abrir ${recurso.titulo}`}>
                                Abrir <span aria-hidden="true">→</span>
                              </a>
                            ) : recurso.estado === "disponible" ? (
                              <span class="resource-row__available">En el archivo</span>
                            ) : (
                              <span class="resource-row__soon">Próximamente</span>
                            )}
                          </span>
                        </li>
                      )
                    })}
                  </ul>
                  {categoria.estado === "en-preparacion" && (
                    <p class="module-entry__prep">
                      Todavía no hay entradas publicadas en este módulo. Se anunciará en la
                      bitácora.
                    </p>
                  )}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page home-section__grid">
      <div class="home-section__aside">
        <p class="running-head">02 / Bitácora</p>
        <h2 class="home-section__title">Lo último que salió del laboratorio.</h2>
        <p class="home-section__lead">
          Una entrada reciente y tres formas de empezar según lo que ya está publicado.
        </p>
        <a class="arrow-link home-section__more" href={`${base}blog/`}>
          Ver toda la bitácora{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>

      <div class="home-section__body recent-grid">
        {ultimoPost && ultimoPostSlug ? (
          <article class="recent-post sheet sheet--cut">
            <span class="tape recent-post__tape" aria-hidden="true"></span>
            <div class="recent-post__top">
              <span class="docket">Bitácora / última entrada</span>
              <time class="meta" datetime={ultimoPost.data.date.toISOString()}>
                {fecha(ultimoPost.data.date)}
              </time>
            </div>
            <h3 class="recent-post__title">
              <a href={`${base}blog/${ultimoPostSlug}/`}>{ultimoPost.data.title}</a>
            </h3>
            <p class="recent-post__desc">{ultimoPost.data.description}</p>
            <ul class="tags recent-post__tags" aria-label="Etiquetas del artículo">
              {ultimoPost.data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            <a class="arrow-link recent-post__link" href={`${base}blog/${ultimoPostSlug}/`}>
              Leer el artículo{" "}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </article>
        ) : (
          <p class="recent-empty sheet sheet--flat sheet__body">
            La bitácora está en pausa. Los avances se publican primero en Threads.
          </p>
        )}

        <div class="route-list">
          <p class="route-list__head">Rutas con material</p>
          <a class="route-row" href={cursoUrl}>
            <span class="route-row__num">01</span>
            <span class="route-row__main">
              <span class="route-row__title">Empezar de cero</span>
              <span class="route-row__detail">8 lecciones de Arch Linux</span>
            </span>
            <span class="route-row__arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="route-row" href={`${base}categorias/#sistemas-y-redes`}>
            <span class="route-row__num">02</span>
            <span class="route-row__main">
              <span class="route-row__title">Practicar la terminal</span>
              <span class="route-row__detail">19 niveles de OverTheWire Bandit</span>
            </span>
            <span class="route-row__arrow" aria-hidden="true">
              →
            </span>
          </a>
          <a class="route-row" href={`${base}categorias/#pentesting-web`}>
            <span class="route-row__num">03</span>
            <span class="route-row__main">
              <span class="route-row__title">Entender la web</span>
              <span class="route-row__detail">Laboratorio de PortSwigger</span>
            </span>
            <span class="route-row__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="method-head">
        <p class="running-head">03 / Método de campo</p>
        <h2 class="home-section__title">Entender, reproducir, registrar.</h2>
        <p class="home-section__lead">
          Cada lección tiene una guía escrita y un video. Primero entiendes el problema; después lo
          repites en tu máquina.
        </p>
      </div>

      <ol class="method-list">
        <li>
          <span class="method-list__num">01</span>
          <h3>Entiende el contexto</h3>
          <p>
            Cada lección abre con el problema y el porqué. Los comandos vienen después, no antes.
          </p>
        </li>
        <li>
          <span class="method-list__num">02</span>
          <h3>Reproduce en tu máquina</h3>
          <p>
            Las guías asumen un laboratorio propio o una máquina virtual. Nada de ataques a sistemas
            ajenos.
          </p>
        </li>
        <li>
          <span class="method-list__num">03</span>
          <h3>Registra tu avance</h3>
          <p>
            El progreso vive en tu navegador. Sin cuentas, sin correos y sin cookies de terceros.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="home-limits">
    <div class="container-page">
      <p class="running-head">04 / Límites</p>
      <div class="home-limits__body">
        <div>
          <h2 class="home-limits__title">El permiso no es opcional.</h2>
          <p class="home-limits__text">
            Todo lo que se enseña aquí se practica en máquinas propias o en laboratorios con
            autorización. Fuera de ahí, no es auditoría: es delito.
          </p>
        </div>
        <div class="home-limits__actions">
          <a
            class="btn btn-secondary"
            href="https://github.com/NeTenebraes/neCyberWiki/blob/main/content/Codigo%20de%20conducta.md"
            target="_blank"
            rel="noopener"
          >
            Leer el código de conducta <span aria-hidden="true">↗</span>
          </a>
          <span class="stamp stamp--faint">Permiso o nada</span>
        </div>
      </div>
    </div>
  </section>

  <script
    is:inline
    type="application/json"
    id="home-lesson-data"
    set:html={JSON.stringify(lessonData).replace(/</g, "\\u003c")}
  ></script>

  <script is:inline>
    // Sector map: open the matching module dossier and keep aria-expanded in sync.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

    for (const node of document.querySelectorAll("[data-board-target]")) {
      node.addEventListener("click", () => {
        const target = document.getElementById(node.getAttribute("data-board-target") || "")
        if (!target) return
        target.open = true
        node.setAttribute("aria-expanded", "true")
        const summary = target.querySelector("summary")
        summary?.focus({ preventScroll: true })
        target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" })
      })
    }

    for (const entry of document.querySelectorAll(".module-entry")) {
      entry.addEventListener("toggle", () => {
        const node = document.querySelector(`[data-board-target="${entry.id}"]`)
        node?.setAttribute("aria-expanded", String(entry.open))
      })
    }

    try {
      const data = JSON.parse(document.getElementById("home-lesson-data")?.textContent || "[]")
      const done = new Set(
        JSON.parse(localStorage.getItem("ncw:progress:arch-linux-facil") || "[]"),
      )
      const total = data.length
      const count = data.filter((leccion) => done.has(leccion.slug)).length
      const pct = total ? Math.round((count / total) * 100) : 0

      const label = document.getElementById("hero-progress-label")
      const fill = document.getElementById("hero-progress-fill")
      const track = document.getElementById("hero-progress")
      if (label) label.textContent = `${count} / ${total}`
      if (fill) fill.style.width = `${pct}%`
      if (track) track.setAttribute("aria-valuenow", String(count))

      const continueLink = document.getElementById("home-continue")
      const continueText = document.getElementById("home-continue-text")
      if (continueLink && continueText) {
        const next = data.find((leccion) => !done.has(leccion.slug))
        if (next) {
          continueLink.href = next.href
          continueText.textContent = count === 0 ? "Empezar el curso" : "Continuar donde lo dejaste"
        } else {
          continueLink.href = continueLink.dataset.courseHref || continueLink.href
          continueText.textContent = "Repasar el curso"
        }
      }
    } catch {}
  </script>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(2.75rem, 6vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-traces {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(
        90deg,
        transparent 0 49.7%,
        color-mix(in srgb, var(--accent) 16%, transparent) 49.7% 50%,
        transparent 50% 100%
      ),
      linear-gradient(
        0deg,
        transparent 0 71.8%,
        color-mix(in srgb, var(--stamp) 18%, transparent) 71.8% 72%,
        transparent 72% 100%
      ),
      radial-gradient(circle at 1px 1px, var(--line) 0.7px, transparent 0.8px);
    background-size:
      100% 100%,
      100% 100%,
      22px 22px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
    opacity: 0.55;
  }

  .home-hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.1rem;
    margin-bottom: 1.5rem;
  }

  .home-hero__title {
    max-width: 13ch;
    font-size: clamp(2.55rem, 5.6vw, 5.15rem);
    line-height: 0.92;
  }

  .home-hero__title em {
    color: var(--stamp);
    font-style: italic;
    font-variation-settings:
      "SOFT" 60,
      "WONK" 1,
      "opsz" 144;
  }

  .home-hero__lead {
    margin-top: 1.6rem;
    max-width: 52ch;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 2.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .hero-facts > div {
    padding-right: 1.5rem;
  }

  .hero-facts > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero-facts dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-facts dd span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  /* --- Course dossier --------------------------------------------------- */

  .dossier-cover {
    --sheet-cut: 30px;
    position: relative;
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--bg-raised);
  }

  .dossier-cover__tape {
    top: -0.55rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .dossier-cover__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .dossier-cover__title {
    margin-top: 1rem;
    font-size: clamp(1.65rem, 2.5vw, 2.15rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .dossier-cover__desc {
    margin-top: 0.65rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .dossier-cover__modules {
    margin-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .dossier-cover__modules li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: baseline;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--line);
  }

  .dossier-cover__mod-num {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--accent);
  }

  .dossier-cover__mod-title {
    color: var(--ink);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .dossier-cover__mod-count {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-muted);
  }

  .dossier-cover__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-muted);
  }

  .dossier-cover__progress {
    padding-block: 0.85rem 0.2rem;
  }

  .dossier-cover__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .dossier-cover__link span:last-child {
    transition: transform var(--dur-ui) var(--ease-out);
  }


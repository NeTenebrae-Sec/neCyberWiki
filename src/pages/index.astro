---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import CourseCard from "../components/CourseCard.astro"
import { getCategoriasConContenido, getCursosPublicados } from "../lib/catalog"
import { roadmap } from "../data/roadmap"
import { site } from "../data/site"

const base = site.base
const cursos = await getCursosPublicados()
const categorias = await getCategoriasConContenido()
const disponibles = categorias.filter((categoria) => categoria.disponible)
const totalLecciones = cursos.reduce((total, curso) => total + curso.lecciones.length, 0)
const routeGroups = [
  {
    id: "foundations-systems",
    number: "01",
    title: "Base y sistemas",
    description: "Los fundamentos para moverte con criterio antes de tocar una herramienta.",
    categories: ["fundamentos-y-etica", "linux-y-sistemas"],
  },
  {
    id: "networks-automation",
    number: "02",
    title: "Redes y automatización",
    description:
      "Cómo entender lo que ocurre en una red y convertir tareas repetidas en herramientas.",
    categories: ["redes-y-servicios", "programacion-y-automatizacion"],
  },
  {
    id: "web-labs",
    number: "03",
    title: "Web y laboratorios",
    description:
      "Metodología para estudiar aplicaciones, máquinas y retos en entornos controlados.",
    categories: ["pentesting-web", "maquinas-y-ctfs"],
  },
  {
    id: "intelligence-privacy",
    number: "04",
    title: "IA y privacidad",
    description: "Decisiones sostenibles sobre modelos, datos, credenciales y huella digital.",
    categories: ["ia-y-seguridad", "privacidad-y-opsec"],
  },
].map((group) => ({
  ...group,
  categories: group.categories.map((id) => categorias.find((categoria) => categoria.id === id)!),
}))

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
const entradasRoadmap = [...roadmap]
  .sort((a, b) => (b.fecha ?? "").localeCompare(a.fecha ?? ""))
  .slice(0, 3)
const fecha = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date)
---

<BaseLayout
  titulo="Bitácora de ciberseguridad"
  descripcion="Cursos, laboratorios y bitácora sobre Linux, redes y ciberseguridad en español. Sin cuentas, sin backend y con el progreso guardado en tu navegador."
>
  <section class="home-hero">
    <div class="container-page">
      <div class="home-hero__main">
        <div class="home-hero__copy">
          <p class="kicker home-hero__kicker">Bitácora de ciberseguridad</p>

          <h1 class="display home-hero__title">
            Aprende informática y ciberseguridad <em>gratis</em>
          </h1>

          <p class="lead home-hero__lead">
            <strong>{site.nombre}</strong> es una guía abierta en español con cursos paso a paso
            sobre Linux, redes y seguridad ofensiva. Sin cuentas y con tu progreso guardado en el
            navegador.
          </p>

          <div class="home-hero__actions">
            <a class="btn btn-primary btn-lg home-hero__cta" href="#cursos">
              <span>Explorar cursos</span>
              <span class="home-hero__cta-arrow" aria-hidden="true">
                ↓
              </span>
            </a>
          </div>
        </div>

        <aside class="home-hero__meta" aria-label="Resumen del archivo y accesos rápidos">
          <dl class="hero-facts">
            <div class="hero-facts__row">
              <dt>Cursos</dt>
              <dd>
                {String(cursos.length).padStart(2, "0")} <span>publicados</span>
              </dd>
            </div>
            <div class="hero-facts__row">
              <dt>Lecciones</dt>
              <dd>
                {String(totalLecciones).padStart(2, "0")} <span>disponibles</span>
              </dd>
            </div>
            <div class="hero-facts__row">
              <dt>Categorías</dt>
              <dd>
                {String(disponibles.length).padStart(2, "0")}{" "}
                <span>/ {String(categorias.length).padStart(2, "0")} activas</span>
              </dd>
            </div>
          </dl>

          <nav class="hero-links" aria-label="Accesos rápidos">
            <a class="hero-link hero-link--primary" href={`${base}bitacora/`}>
              <span>Leer la bitácora</span>
              <span class="hero-link__arrow" aria-hidden="true">
                →
              </span>
            </a>

            <a class="hero-link" href={site.redes.github} target="_blank" rel="noopener noreferrer">
              <svg
                class="hero-link__icon"
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M8 1.25l2.09 4.24 4.68.68-3.39 3.3.8 4.66L8 11.93l-4.18 2.2.8-4.66-3.39-3.3 4.68-.68L8 1.25z" />
              </svg>
              <span>Dar una estrella en GitHub</span>
              <span class="hero-link__ext" aria-hidden="true">
                ↗
              </span>
              <span class="sr-only">(abre en nueva pestaña)</span>
            </a>

            <a
              class="hero-link hero-link--youtube"
              href={site.redes.youtube}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="hero-link__icon"
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <rect x="1.5" y="3.25" width="13" height="9.5" rx="2" />
                <path d="M6.75 5.85L10.5 8l-3.75 2.15V5.85z" fill="currentColor" stroke="none" />
              </svg>
              <span>Ver el canal en YouTube</span>
              <span class="hero-link__ext" aria-hidden="true">
                ↗
              </span>
              <span class="sr-only">(abre en nueva pestaña)</span>
            </a>
          </nav>
        </aside>
      </div>

      <div class="home-hero__scroll-cue">
        <span class="home-hero__scroll-label">Sigue bajando</span>
        <span class="home-hero__scroll-rule" aria-hidden="true"></span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M10 4v11" />
          <path d="M5.5 10.5L10 15l4.5-4.5" />
        </svg>
      </div>
    </div>
  </section>

  <section class="home-section" id="cursos">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">01 / Cursos</p>
          <h2 class="home-section__title">Lo que ya se puede estudiar.</h2>
        </div>
        <a class="arrow-link" href={`${base}cursos/`}>
          Ver el catálogo completo <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="course-grid">
        {cursos.map((curso) => (
          <CourseCard curso={curso} variant="compact" />
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page home-routes">
      <div>
        <p class="running-head">02 / Rutas</p>
        <h2 class="home-section__title">Cuatro mapas para orientarte.</h2>
        <p class="home-section__lead">
          Agrupamos las ocho categorías en cuatro rutas de entrada. Abre un mapa para ver qué ya
          está disponible y qué sigue en preparación.
        </p>
      </div>

      <div class="route-groups" data-route-accordion>
        {routeGroups.map((group) => (
          <article class="route-group">
            <h3 class="route-group__heading">
              <button
                class="route-group__trigger"
                type="button"
                aria-expanded="false"
                aria-controls={`${group.id}-panel`}
              >
                <span class="route-group__number">{group.number}</span>
                <span class="route-group__heading-copy">
                  <span class="route-group__title">{group.title}</span>
                  <span class="route-group__description">{group.description}</span>
                </span>
                <span class="route-group__icon" aria-hidden="true">
                  +
                </span>
              </button>
            </h3>
            <div
              class="route-group__panel"
              id={`${group.id}-panel`}
              role="region"
              aria-label={group.title}
              hidden
            >
              <button class="route-group__back" type="button" data-route-back>
                <span aria-hidden="true">←</span> Volver a los mapas
              </button>
              <ul class="route-group__categories">
                {group.categories.map((categoria) => (
                  <li
                    class:list={["route-category", categoria.disponible && "route-category--open"]}
                  >
                    <a href={`${base}cursos/${categoria.id}/`}>
                      <span class="route-category__top">
                        <span class="route-category__number">{categoria.indice}</span>
                        <span class="route-category__state">
                          {categoria.disponible ? "Abierta" : "En preparación"}
                        </span>
                      </span>
                      <strong>{categoria.titulo}</strong>
                      <span>
                        {categoria.disponible
                          ? `${categoria.cursos.length} ${categoria.cursos.length === 1 ? "curso" : "cursos"} · ${categoria.totalLecciones} lecciones`
                          : categoria.tagline}
                      </span>
                      <span class="route-category__arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">03 / Bitácora</p>
          <h2 class="home-section__title">Mis últimas notas.</h2>
          <p class="home-section__lead">
            Ideas, hallazgos y pequeñas decisiones que no necesitan convertirse en un curso
            completo.
          </p>
        </div>
        <a class="arrow-link" href={`${base}bitacora/`}>
          Ver toda la bitácora <span aria-hidden="true">→</span>
        </a>
      </div>

      {posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => {
            const slug = post.id.split("/").pop()
            return (
              <li>
                <a class="post-row" href={`${base}bitacora/${slug}/`}>
                  <time class="post-row__date" datetime={post.data.date.toISOString()}>
                    {fecha(post.data.date)}
                  </time>
                  <span class="post-row__main">
                    <span class="post-row__title">{post.data.title}</span>
                    <span class="post-row__desc">{post.data.description}</span>
                  </span>
                  <span class="post-row__side">
                    <span class="post-row__tags" aria-label="Hashtags">
                      {post.data.tags.slice(0, 3).map((tag) => `#${tag}`)}
                    </span>
                    <span class="post-row__arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      ) : (
        <p class="home-section__empty sheet sheet--flat">
          Todavía no hay entradas publicadas. Cuando haya algo que no justifique un curso, aparecerá
          aquí.
        </p>
      )}
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">05 / Cambios</p>
          <h2 class="home-section__title">Roadmap y notas de desarrollo.</h2>
          <p class="home-section__lead">
            El roadmap muestra lo que está hecho, en curso y planeado. Las notas de desarrollo
            cuentan las decisiones que van convirtiendo esas ideas en una web real.
          </p>
        </div>
        <div class="home-section__links">
          <a class="arrow-link" href={`${base}roadmap/`}>
            Ver el roadmap <span aria-hidden="true">→</span>
          </a>
          <a class="arrow-link" href={`${base}bitacora/`}>
            Leer las notas <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <ul class="post-list">
        {entradasRoadmap.map((item) => (
          <li>
            <a
              class="post-row"
              href={item.enlace ? `${base}${item.enlace.replace(/^\//, "")}` : `${base}roadmap/`}
            >
              <time class="post-row__date" datetime={item.fecha ?? undefined}>
                {item.estado.replace("-", " ")}
              </time>
              <span class="post-row__main">
                <span class="post-row__title">{item.titulo}</span>
                <span class="post-row__desc">{item.resumen}</span>
              </span>
              <span class="post-row__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-section home-section--support">
    <div class="container-page support-grid">
      <div>
        <p class="running-head">04 / Apoyo</p>
        <h2 class="home-section__title">Gratis para aprender.</h2>
        <p class="home-section__lead">
          No hay muro de pago ni cuentas. Si esta bitácora te ahorra tiempo o te ayuda a entender
          algo difícil, puedes invitar un café para sostener el laboratorio y la escritura.
        </p>
        <div class="support-callout sheet sheet--cut">
          <span class="tape support-callout__tape" aria-hidden="true"></span>
          <span class="docket">Apoyo directo</span>
          <strong>Una taza mantiene encendida la mesa de trabajo.</strong>
          <a class="btn btn-primary" href={site.koFi} target="_blank" rel="noopener">
            Apoyar en Ko-fi <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="support-note sheet sheet--flat">
        <p class="docket">Regla de campo</p>
        <h3>El permiso no es opcional.</h3>
        <p>
          Todo lo que se enseña aquí se practica en máquinas propias o en laboratorios con
          autorización. Fuera de ahí, no es auditoría: es delito.
        </p>
        <a class="arrow-link" href={`${base}terminos/`}>
          Leer los términos <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(3rem, 6.5vw, 5rem) clamp(2rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--line);
  }

  .home-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.72fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }

  .home-hero__copy {
    min-width: 0;
  }

  .home-hero__kicker {
    margin: 0;
    color: var(--ink-muted);
  }

  .home-hero__title {
    margin-block-start: 1.1rem;
    max-width: 16ch;
    font-size: clamp(2.5rem, 4.9vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .home-hero__title em {
    color: var(--accent);
    font-style: italic;
  }

  .home-hero__lead {
    margin-block-start: 1.35rem;
    max-width: 52ch;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-block-start: 2rem;
  }

  .home-hero__cta {
    gap: 0.85rem;
    padding: 0.9rem 1.55rem;
    font-size: 0.94rem;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 150ms ease-out,
      border-color 150ms ease-out,
      color 150ms ease-out,
      transform 150ms ease-out;
  }

  .home-hero__cta:not(:disabled):active {
    transform: scale(0.96);
  }

  .home-hero__cta-arrow {
    display: inline-block;
    font-size: 1.15em;
    line-height: 1;
  }

  .home-hero__meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-inline-start: clamp(1.5rem, 3vw, 2.5rem);
    border-inline-start: 1px solid var(--line);
  }

  .hero-facts {
    display: grid;
    margin: 0;
    padding: 0;
  }

  .hero-facts__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-facts__row:first-child {
    padding-block-start: 0;
  }

  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero-facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    text-align: right;
  }

  .hero-facts dd span {
    color: var(--ink-muted);
  }

  .hero-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding-block: 0.35rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .hero-link--primary {
    color: var(--accent);
    font-weight: 500;
  }

  .hero-link__icon {
    flex-shrink: 0;
    color: var(--stamp);
  }

  .hero-link--youtube .hero-link__icon {
    color: var(--ink-dim);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__cta-arrow,
    .hero-link__arrow,
    .hero-link__ext {
      transition: transform 150ms ease-out;
    }

    .home-hero__cta:focus-visible .home-hero__cta-arrow {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .home-hero__cta:hover .home-hero__cta-arrow {
      transform: translateY(3px);
    }

    .hero-link:hover .hero-link__ext {
      transform: translate(2px, -2px);
    }

    .hero-link--primary:hover .hero-link__arrow {
      transform: translateX(3px);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-link:hover {
      color: var(--accent);
    }
  }

  .home-hero__scroll-cue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-block-start: clamp(2.25rem, 4.5vw, 3.25rem);
    color: var(--ink-muted);
    pointer-events: none;
    user-select: none;
  }

  .home-hero__scroll-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-hero__scroll-rule {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }

  .home-hero__scroll-cue svg {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero__scroll-cue {
      animation: hero-cue-in 420ms var(--ease-out) 400ms both;
    }

    .home-hero__scroll-cue svg {
      animation: hero-cue-nudge 1.2s var(--ease-in-out) 900ms 2 both;
    }

    .home-hero__scroll-rule {
      animation: hero-cue-rule 500ms var(--ease-out) 650ms both;
    }

    @keyframes hero-cue-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes hero-cue-nudge {
      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(5px);
      }
    }

    @keyframes hero-cue-rule {
      from {
        transform: scaleX(0);
      }

      to {
        transform: scaleX(1);
      }
    }

    .home-hero__copy,
    .home-hero__meta {
      animation: hero-enter 300ms var(--ease-out) both;
    }

    .home-hero__meta {
      animation-delay: 100ms;
    }

    @keyframes hero-enter {
      from {
        opacity: 0;
        filter: blur(4px);
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
      }
    }
  }

  .route-category__arrow,
  .support-callout .btn span {
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .route-category a:hover .route-category__arrow,
  .support-callout .btn:hover span {
    transform: translateX(3px);
  }

  .route-groups {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    height: 27rem;
    align-content: center;
  }

  .route-group {
    border: 1px solid var(--line);
    background: var(--bg-raised);
    transition:
      transform 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      opacity 180ms var(--ease-out);
  }

  .route-groups:not(.is-detail) .route-group {
    min-height: 9.5rem;
  }

  .route-groups:not(.is-detail) .route-group:hover,
  .route-groups:not(.is-detail) .route-group:has(:focus-visible) {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .route-group__trigger {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem;
    border: 0;
    color: var(--ink);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  /* Hover en cualquier punto de la tarjeta, sin importar el modo (grid o detalle) */
  .route-group:hover .route-group__trigger,
  .route-group:has(:focus-visible) .route-group__trigger {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .route-group__number,
  .route-category__number {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
  }

  .route-group__title {
    display: block;

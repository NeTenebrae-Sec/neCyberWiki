---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import CourseCard from "../components/CourseCard.astro"
import { getCategoriasConContenido, getCursosPublicados, leccionUrl } from "../lib/catalog"
import { roadmap } from "../data/roadmap"
import { site } from "../data/site"

const base = site.base
const cursos = await getCursosPublicados()
const categorias = await getCategoriasConContenido()
const disponibles = categorias.filter((categoria) => categoria.disponible)
const destacado = cursos[0]
const primeraLeccion = destacado?.lecciones[0]
const empezarUrl =
  destacado && primeraLeccion ? leccionUrl(destacado, primeraLeccion, base) : `${base}cursos/`
const totalLecciones = cursos.reduce((total, curso) => total + curso.lecciones.length, 0)
const routeGroups = [
  {
    id: "foundations-systems",
    number: "01",
    title: "Base y sistemas",
    description: "Los fundamentos para moverte con criterio antes de tocar una herramienta.",
    categories: ["fundamentos-y-etica", "linux-y-sistemas"],
  },
  {
    id: "networks-automation",
    number: "02",
    title: "Redes y automatización",
    description:
      "Cómo entender lo que ocurre en una red y convertir tareas repetidas en herramientas.",
    categories: ["redes-y-servicios", "programacion-y-automatizacion"],
  },
  {
    id: "web-labs",
    number: "03",
    title: "Web y laboratorios",
    description:
      "Metodología para estudiar aplicaciones, máquinas y retos en entornos controlados.",
    categories: ["pentesting-web", "maquinas-y-ctfs"],
  },
  {
    id: "intelligence-privacy",
    number: "04",
    title: "IA y privacidad",
    description: "Decisiones sostenibles sobre modelos, datos, credenciales y huella digital.",
    categories: ["ia-y-seguridad", "privacidad-y-opsec"],
  },
].map((group) => ({
  ...group,
  categories: group.categories.map((id) => categorias.find((categoria) => categoria.id === id)!),
}))

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
const entradasRoadmap = [...roadmap]
  .sort((a, b) => (b.fecha ?? "").localeCompare(a.fecha ?? ""))
  .slice(0, 3)
const fecha = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date)
---

<BaseLayout
  titulo="Bitácora de ciberseguridad"
  descripcion="Cursos, laboratorios y bitácora sobre Linux, redes y ciberseguridad en español. Sin cuentas, sin backend y con el progreso guardado en tu navegador."
>
  <section class="home-hero">
    <div class="container-page home-hero__grid">
      <div class="home-hero__copy">
        <div class="hero-docket">
          <span class="docket">Bitácora de aprendizaje</span>
          <span class="stamp">Aprendizaje abierto</span>
        </div>

        <h1 class="display home-hero__title">
          Aprende a <em>leer</em> el sistema antes de auditarlo.
        </h1>

        <p class="lead home-hero__lead">
          Una bitácora personal de cursos y notas de campo sobre Linux, redes y ciberseguridad. Todo
          en español, sin cuentas y con tu avance guardado en el navegador.
        </p>

        <div class="home-hero__actions">
          <a class="btn btn-primary btn-lg" href={`${base}cursos/`}>
            Explorar los cursos <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-secondary btn-lg" href={`${base}bitacora/`}>
            Leer la bitácora
          </a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>Cursos</dt>
            <dd>{String(cursos.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Lecciones</dt>
            <dd>{String(totalLecciones).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Rutas abiertas</dt>
            <dd>
              {String(disponibles.length).padStart(2, "0")} <span>/ {categorias.length}</span>
            </dd>
          </div>
        </dl>
      </div>

      <aside class="hero-index sheet sheet--flat" aria-label="Resumen del archivo">
        <div class="hero-index__top">
          <span class="docket">Estado del archivo</span>
          <span class="hero-index__mark" aria-hidden="true">
            01
          </span>
        </div>
        <div class="hero-index__line">
          <span>Curso destacado</span>
          <strong>{destacado?.titulo ?? "Próximamente"}</strong>
        </div>
        <div class="hero-index__line">
          <span>Última lección</span>
          <strong>{destacado?.lecciones.at(-1)?.title ?? "En preparación"}</strong>
        </div>
        <a class="hero-index__link" href={empezarUrl}>
          <span>{destacado ? "Empezar por una lección" : "Explorar el catálogo"}</span>
          <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">01 / Cursos</p>
          <h2 class="home-section__title">Lo que ya se puede estudiar.</h2>
        </div>
        <a class="arrow-link" href={`${base}cursos/`}>
          Ver el catálogo completo <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="course-grid">
        {cursos.map((curso) => (
          <CourseCard curso={curso} variant="compact" />
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page home-routes">
      <div>
        <p class="running-head">02 / Rutas</p>
        <h2 class="home-section__title">Cuatro mapas para orientarte.</h2>
        <p class="home-section__lead">
          Agrupamos las ocho categorías en cuatro rutas de entrada. Abre un mapa para ver qué ya
          está disponible y qué sigue en preparación.
        </p>
      </div>

      <div class="route-groups" data-route-accordion>
        {routeGroups.map((group) => (
          <article class="route-group">
            <h3 class="route-group__heading">
              <button
                class="route-group__trigger"
                type="button"
                aria-expanded="false"
                aria-controls={`${group.id}-panel`}
              >
                <span class="route-group__number">{group.number}</span>
                <span class="route-group__heading-copy">
                  <span class="route-group__title">{group.title}</span>
                  <span class="route-group__description">{group.description}</span>
                </span>
                <span class="route-group__icon" aria-hidden="true">
                  +
                </span>
              </button>
            </h3>
            <div
              class="route-group__panel"
              id={`${group.id}-panel`}
              role="region"
              aria-label={group.title}
              hidden
            >
              <button class="route-group__back" type="button" data-route-back>
                <span aria-hidden="true">←</span> Volver a los mapas
              </button>
              <ul class="route-group__categories">
                {group.categories.map((categoria) => (
                  <li
                    class:list={["route-category", categoria.disponible && "route-category--open"]}
                  >
                    <a href={`${base}cursos/${categoria.id}/`}>
                      <span class="route-category__top">
                        <span class="route-category__number">{categoria.indice}</span>
                        <span class="route-category__state">
                          {categoria.disponible ? "Abierta" : "En preparación"}
                        </span>
                      </span>
                      <strong>{categoria.titulo}</strong>
                      <span>
                        {categoria.disponible
                          ? `${categoria.cursos.length} ${categoria.cursos.length === 1 ? "curso" : "cursos"} · ${categoria.totalLecciones} lecciones`
                          : categoria.tagline}
                      </span>
                      <span class="route-category__arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">03 / Bitácora</p>
          <h2 class="home-section__title">Mis últimas notas.</h2>
          <p class="home-section__lead">
            Ideas, hallazgos y pequeñas decisiones que no necesitan convertirse en un curso
            completo.
          </p>
        </div>
        <a class="arrow-link" href={`${base}bitacora/`}>
          Ver toda la bitácora <span aria-hidden="true">→</span>
        </a>
      </div>

      {posts.length > 0 ? (
        <ul class="post-list">
          {posts.map((post) => {
            const slug = post.id.split("/").pop()
            return (
              <li>
                <a class="post-row" href={`${base}bitacora/${slug}/`}>
                  <time class="post-row__date" datetime={post.data.date.toISOString()}>
                    {fecha(post.data.date)}
                  </time>
                  <span class="post-row__main">
                    <span class="post-row__title">{post.data.title}</span>
                    <span class="post-row__desc">{post.data.description}</span>
                  </span>
                  <span class="post-row__side">
                    <span class="post-row__tags" aria-label="Hashtags">
                      {post.data.tags.slice(0, 3).map((tag) => `#${tag}`)}
                    </span>
                    <span class="post-row__arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      ) : (
        <p class="home-section__empty sheet sheet--flat">
          Todavía no hay entradas publicadas. Cuando haya algo que no justifique un curso, aparecerá
          aquí.
        </p>
      )}
    </div>
  </section>

  <section class="home-section">
    <div class="container-page">
      <div class="home-section__head">
        <div>
          <p class="running-head">05 / Cambios</p>
          <h2 class="home-section__title">Roadmap y notas de desarrollo.</h2>
          <p class="home-section__lead">
            El roadmap muestra lo que está hecho, en curso y planeado. Las notas de desarrollo
            cuentan las decisiones que van convirtiendo esas ideas en una web real.
          </p>
        </div>
        <div class="home-section__links">
          <a class="arrow-link" href={`${base}roadmap/`}>
            Ver el roadmap <span aria-hidden="true">→</span>
          </a>
          <a class="arrow-link" href={`${base}bitacora/`}>
            Leer las notas <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <ul class="post-list">
        {entradasRoadmap.map((item) => (
          <li>
            <a
              class="post-row"
              href={item.enlace ? `${base}${item.enlace.replace(/^\//, "")}` : `${base}roadmap/`}
            >
              <time class="post-row__date" datetime={item.fecha ?? undefined}>
                {item.estado.replace("-", " ")}
              </time>
              <span class="post-row__main">
                <span class="post-row__title">{item.titulo}</span>
                <span class="post-row__desc">{item.resumen}</span>
              </span>
              <span class="post-row__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-section home-section--support">
    <div class="container-page support-grid">
      <div>
        <p class="running-head">04 / Apoyo</p>
        <h2 class="home-section__title">Gratis para aprender.</h2>
        <p class="home-section__lead">
          No hay muro de pago ni cuentas. Si esta bitácora te ahorra tiempo o te ayuda a entender
          algo difícil, puedes invitar un café para sostener el laboratorio y la escritura.
        </p>
        <div class="support-callout sheet sheet--cut">
          <span class="tape support-callout__tape" aria-hidden="true"></span>
          <span class="docket">Apoyo directo</span>
          <strong>Una taza mantiene encendida la mesa de trabajo.</strong>
          <a class="btn btn-primary" href={site.koFi} target="_blank" rel="noopener">
            Apoyar en Ko-fi <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="support-note sheet sheet--flat">
        <p class="docket">Regla de campo</p>
        <h3>El permiso no es opcional.</h3>
        <p>
          Todo lo que se enseña aquí se practica en máquinas propias o en laboratorios con
          autorización. Fuera de ahí, no es auditoría: es delito.
        </p>
        <a class="arrow-link" href={`${base}terminos/`}>
          Leer los términos <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(2.75rem, 6vw, 5.5rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.55fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.1rem;
    margin-bottom: 1.5rem;
  }

  .home-hero__title {
    max-width: 13ch;
    font-size: clamp(2.55rem, 5.6vw, 5.15rem);
    line-height: 0.92;
  }

  .home-hero__title em {
    color: var(--stamp);
    font-style: italic;
  }

  .home-hero__lead {
    margin-top: 1.6rem;
    max-width: 52ch;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    margin-top: 2.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .hero-facts > div {
    padding-right: 1.5rem;
  }

  .hero-facts > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero-facts dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-facts dd span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .hero-index {
    position: relative;
    padding: 1.25rem;
    border-top: 3px solid var(--accent);
    background:
      linear-gradient(
        135deg,
        transparent 0 86%,
        color-mix(in srgb, var(--accent) 12%, transparent) 86%
      ),
      var(--bg-raised);
  }

  .hero-index__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .hero-index__mark {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
  }

  .hero-index__line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.72rem;
  }

  .hero-index__line:first-of-type {
    margin-top: 1rem;
  }

  .hero-index__line strong {
    max-width: 13rem;
    color: var(--ink);
    font-size: 0.78rem;
    text-align: right;
  }

  .hero-index__link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .hero-index__link span:last-child,
  .route-category__arrow,
  .support-callout .btn span {
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .hero-index__link:hover span:last-child,
  .route-category a:hover .route-category__arrow,
  .support-callout .btn:hover span {
    transform: translateX(3px);
  }

  .route-groups {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    height: 27rem;
    align-content: center;
  }

  .route-group {
    border: 1px solid var(--line);
    background: var(--bg-raised);
    transition:
      transform 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      opacity 180ms var(--ease-out);
  }

  .route-groups:not(.is-detail) .route-group {
    min-height: 9.5rem;
  }

  .route-groups:not(.is-detail) .route-group:hover,
  .route-groups:not(.is-detail) .route-group:has(:focus-visible) {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .route-group__trigger {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    width: 100%;
    padding: 1rem;
    border: 0;
    color: var(--ink);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  /* Hover en cualquier punto de la tarjeta, sin importar el modo (grid o detalle) */
  .route-group:hover .route-group__trigger,
  .route-group:has(:focus-visible) .route-group__trigger {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .route-group__number,
  .route-category__number {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
  }

  .route-group__title {
    display: block;
    font-size: 1rem;
    font-weight: 650;
  }

  .route-group__description {
    display: block;
    margin-top: 0.3rem;
    color: var(--ink-dim);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .route-group__icon {
    font-size: 1.2rem;
    line-height: 1;
    color: var(--accent);
  }

  .route-group__icon::before {
    content: "ABRIR";
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.46rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .route-group__panel {
    display: none;
    padding: 0 0.75rem 0.75rem;
  }

  .route-groups.is-detail {
    display: block;
    padding-top: 0.25rem;
  }

  .route-groups.is-detail .route-group {
    display: none;
  }

  .route-groups.is-detail .route-group.is-selected {
    display: block;
    border-color: var(--line-strong);
    animation: route-detail-in 180ms var(--ease-out) both;
  }

  .route-groups.is-detail .route-group.is-selected .route-group__trigger {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .route-groups.is-detail .route-group.is-selected .route-group__icon {
    display: none;
  }

  .route-groups.is-detail .route-group.is-selected .route-group__panel {
    display: block;
  }

  .route-group__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 0 0.9rem;
    padding: 0.35rem 0;
    border: 0;
    color: var(--accent);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .route-group__back:hover {
    color: var(--ink);
  }

  .route-group__categories {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .route-category {
    opacity: 0.72;
  }

  .route-category--open {
    opacity: 1;
  }

  .route-category a {
    position: relative;
    display: block;
    padding: 0.8rem;
    border: 1px solid var(--line);
    text-decoration: none;
  }

  .route-category a:hover {
    border-color: var(--line-strong);
  }

  .route-category__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .route-category__state {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .route-category--open .route-category__state {
    color: var(--signal);
  }

  .route-category strong,
  .route-category > a > span:nth-last-of-type(2) {
    display: block;
    margin-top: 0.45rem;
    color: var(--ink);
    font-size: 0.85rem;
  }

  .route-category > a > span:nth-last-of-type(2) {
    color: var(--ink-dim);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .route-category__arrow {
    position: absolute;
    right: 0.8rem;
    bottom: 0.65rem;
    color: var(--accent);
  }
  .home-section {
    padding-block: clamp(3rem, 6.5vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }

  .home-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .home-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .running-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .running-head::after {
    content: "";
    width: 2rem;
    height: 1px;
    flex-shrink: 0;
    background: var(--line-strong);
  }

  .home-section__title {
    margin-top: 0.8rem;
    font-size: clamp(1.9rem, 3vw, 2.85rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .home-section__lead {
    margin-top: 0.9rem;
    max-width: 44ch;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-dim);
  }

  .course-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .home-routes,
  .support-grid {

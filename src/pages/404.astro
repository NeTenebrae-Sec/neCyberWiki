---
import BaseLayout from "../layouts/BaseLayout.astro"
import { site } from "../data/site"

const base = site.base
---

<BaseLayout titulo="404 — Señal perdida" noindex>
  <section class="notfound container-page">
    <div class="notfound__signal" aria-hidden="true">
      <svg viewBox="0 0 320 120" fill="none">
        <path d="M0 60h84" stroke="var(--line-strong)" stroke-width="1.5" />
        <path d="M236 60h84" stroke="var(--line-strong)" stroke-width="1.5" />
        <path
          d="M84 60h24l8-18 12 36 10-46 12 58 10-40 8 10h38"
          stroke="var(--stamp)"
          stroke-width="1.5"
        />
        <circle cx="160" cy="60" r="5" fill="var(--danger)" />
        <path
          d="M132 32l-10-10M188 32l10-10M132 88l-10 10M188 88l10 10"
          stroke="var(--line-strong)"
        />
      </svg>
    </div>

    <div class="notfound__docket">
      <span class="docket">Error de ruta</span>
      <span class="stamp">Señal perdida</span>
    </div>

    <p class="notfound__code">404</p>
    <h1 class="notfound__title">Esta ruta no existe en el archivo.</h1>
    <p class="notfound__text">
      La página se movió, el endpoint cambió o el contenido todavía está en el horno. Vuelve al
      índice o explora el catálogo por categorías.
    </p>

    <div class="notfound__actions">
      <a class="btn btn-primary" href={base}>
        Volver al inicio <span aria-hidden="true">→</span>
      </a>
      <a class="btn btn-secondary" href={`${base}cursos/`}>
        Abrir el catálogo
      </a>
    </div>

    <p class="notfound__meta">
      Si crees que es un error del sitio,{" "}
      <a href={`${site.redes.github}/issues/new`}>abre un issue</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 7rem);
    text-align: center;
  }

  .notfound__signal {
    width: min(22rem, 80vw);
    color: var(--line-strong);
  }

  .notfound__signal svg {
    width: 100%;
    height: auto;
  }

  .notfound__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem 1rem;
    margin-top: 1.5rem;
  }

  .notfound__code {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 11rem);
    font-weight: 650;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--danger);
    font-variation-settings:
      "SOFT" 20,
      "WONK" 0,
      "opsz" 144;
  }

  .notfound__title {
    margin-top: 1.1rem;
    max-width: 20ch;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    letter-spacing: -0.035em;
  }

  .notfound__text {
    margin-top: 0.8rem;
    max-width: 48ch;
    color: var(--ink-dim);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .notfound__meta {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-muted);
  }

  .notfound__meta a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

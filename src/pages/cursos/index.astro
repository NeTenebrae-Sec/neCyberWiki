---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getCategoriasConContenido } from "../../lib/catalog"
import { site } from "../../data/site"

const categorias = await getCategoriasConContenido()
const disponibles = categorias.filter((categoria) => categoria.disponible)
const preparacion = categorias.filter((categoria) => !categoria.disponible)
const totalCursos = disponibles.reduce((total, categoria) => total + categoria.cursos.length, 0)
const totalLecciones = disponibles.reduce((total, categoria) => total + categoria.totalLecciones, 0)
const base = site.base
---

<BaseLayout
  titulo="Cursos"
  descripcion="Catálogo de cursos por categorías: Linux, redes, programación, pentesting web y más. Contenido educativo en español, sin cuentas y con progreso local."
>
  <section class="catalog-hero">
    <div class="container-page">
      <div class="catalog-hero__docket">
        <span class="docket">Catálogo de cursos</span>
        <span class="stamp">Acceso libre</span>
      </div>

      <div class="catalog-hero__grid">
        <div>
          <h1 class="display catalog-hero__title">
            Cursos abiertos.
            <br />
            Aprende sin ataduras.
          </h1>
          <p class="lead catalog-hero__lead">
            Formación práctica en español: cada curso incluye video, documentación con comandos
            exactos y ejercicios para practicar en tu máquina. Sin registro, sin costo.
          </p>
        </div>

        <dl class="catalog-facts">
          <div>
            <dt>Rutas</dt>
            <dd>{String(categorias.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Cursos</dt>
            <dd>{String(totalCursos).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Lecciones</dt>
            <dd>{String(totalLecciones).padStart(2, "0")}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="catalog-body">
    <div class="container-page">
      <div class="catalog-section">
        <div class="catalog-section__head">
          <p class="label-rule">Disponible ahora</p>
          <span class="meta">
            {disponibles.length} de {categorias.length} rutas abiertas
          </span>
        </div>

        <div class="category-grid">
          {disponibles.map((categoria) => (
            <article class="category-card category-card--active sheet sheet--cut">
              <div class="category-card__head">
                <span class="category-card__index">{categoria.indice}</span>
                <span class="status">
                  <span class="status-dot" aria-hidden="true" />
                  {categoria.cursos.length} {categoria.cursos.length === 1 ? "curso" : "cursos"}
                </span>
              </div>

              <h2 class="category-card__title">
                <a href={`${base}cursos/${categoria.id}/`}>{categoria.titulo}</a>
              </h2>
              <p class="category-card__tagline">{categoria.tagline}</p>

              <ul class="category-card__courses">
                {categoria.cursos.map((curso) => (
                  <li>
                    <a href={`${base}cursos/${categoria.id}/${curso.slug}/`}>
                      <span class="category-card__course-title">{curso.titulo}</span>
                      <span class="category-card__course-meta">
                        {curso.lecciones.length}{" "}
                        {curso.unidad === "nivel" ? "niveles" : "lecciones"} · guía escrita
                      </span>
                      <span class="category-card__arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>

              <a class="category-card__link" href={`${base}cursos/${categoria.id}/`}>
                Abrir la ruta <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>

      {preparacion.length > 0 && (
        <div class="catalog-section catalog-section--muted">
          <div class="catalog-section__head">
            <p class="label-rule">En preparación</p>
            <span class="meta">{preparacion.length} rutas sin cursos publicados</span>
          </div>

          <div class="upcoming-list">
            {preparacion.map((categoria) => (
              <div class="upcoming-list__item">
                <span class="upcoming-list__index">{categoria.indice}</span>
                <a href={`${base}cursos/${categoria.id}/`} class="upcoming-list__link">
                  {categoria.titulo}
                </a>
                <span class="status status--pending">
                  <span class="status-dot status-dot--amber" aria-hidden="true" />
                  Próximamente
                </span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .catalog-hero {
    position: relative;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .catalog-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 1px 1px, var(--line) 0.7px, transparent 0.8px);
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, #000, transparent 75%);
    opacity: 0.5;
  }

  .catalog-hero .container-page {
    position: relative;
    z-index: 1;
  }

  .catalog-hero__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1rem;
    margin-bottom: 1.2rem;
  }

  .catalog-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: end;
  }

  .catalog-hero__title {
    font-size: clamp(2.4rem, 5.5vw, 4.5rem);
    line-height: 0.94;
  }

  .catalog-hero__lead {
    margin-top: 1.2rem;
    max-width: 58ch;
  }

  .catalog-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .catalog-facts > div {
    padding: 0.9rem 0.75rem;
  }

  .catalog-facts > div + div {
    border-left: 1px solid var(--line);
  }

  .catalog-facts dt {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .catalog-facts dd {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .catalog-body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .catalog-section + .catalog-section {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .catalog-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .category-card {
    --sheet-cut: 24px;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 2.4vw, 1.5rem);
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-paper);
  }

  .category-card--active::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 15%, transparent));
  }

  .category-card--muted {
    border-style: dashed;
    background: var(--bg-sunken);
    box-shadow: none;
  }

  .category-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .category-card__index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .category-card__title {
    margin-top: 0.7rem;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.1;
    letter-spacing: -0.028em;
  }

  .category-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .category-card__title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .category-card__tagline {
    margin-top: 0.45rem;
    color: var(--ink-dim);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .category-card__courses {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    list-style: none;
    padding: 0;
  }

  .category-card__courses li + li {
    border-top: 1px solid var(--line);
  }

  .category-card__courses a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem;
    gap: 0.15rem 0.75rem;
    padding-block: 0.7rem;
    text-decoration: none;
  }

  .category-card__course-title {
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .category-card__course-meta {
    grid-column: 1;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .category-card__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--accent);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .category-card__courses a:hover .category-card__course-title {
    color: var(--accent);
  }

  .category-card__courses a:hover .category-card__arrow {
    transform: translateX(3px);
  }

  .category-card__link {
    margin-top: auto;
    padding-top: 0.9rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .category-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .category-card__note {
    margin-top: 0.8rem;
    padding-left: 0.65rem;
    border-left: 2px solid var(--warn);
    color: var(--ink-muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .upcoming-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.75rem;
    background: var(--bg-sunken);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }

  .upcoming-list__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .upcoming-list__item:last-child {
    border-bottom: none;
  }

  .upcoming-list__index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
  }

  .upcoming-list__link {
    color: var(--ink-dim);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
  }

  .upcoming-list__link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  @media (max-width: 900px) {
    .catalog-hero__grid,
    .category-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .catalog-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .catalog-facts > div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .catalog-facts > div + div {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>

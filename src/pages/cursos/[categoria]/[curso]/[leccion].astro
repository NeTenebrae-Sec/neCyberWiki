---
import { getCollection, render } from "astro:content"
import BaseLayout from "../../../../layouts/BaseLayout.astro"
import CourseModuleList from "../../../../components/CourseModuleList.astro"
import CourseConfig from "../../../../components/CourseConfig.astro"
import TableOfContents from "../../../../components/TableOfContents.astro"
import VideoEmbed from "../../../../components/VideoEmbed.astro"
import {
  cursoUrl,
  getCursoPublicado,
  getCursosPublicados,
  leccionUrl,
  leccionesDeRuta,
} from "../../../../lib/catalog"
import { CONFIG_POR_DEFECTO } from "../../../../lib/tracks"
import { getCategoria } from "../../../../data/categorias"
import { site } from "../../../../data/site"

export async function getStaticPaths() {
  const cursos = await getCursosPublicados()
  return cursos.flatMap((curso) =>
    curso.lecciones.map((leccion) => ({
      params: {
        categoria: curso.categoria,
        curso: curso.slug,
        leccion: leccion.slug,
      },
    })),
  )
}

const { categoria: categoriaId, curso: cursoSlug, leccion } = Astro.params
const info = await getCursoPublicado(cursoSlug!)
if (!info) throw new Error(`Curso no publicado: ${cursoSlug}`)
if (info.categoria !== categoriaId) {
  throw new Error(`El curso ${info.slug} no pertenece a la categoría ${categoriaId}`)
}

const entradas = await getCollection(
  "cursos",
  ({ data }) => !data.draft && data.curso === cursoSlug,
)
const entry = entradas.find((item) => item.id.split("/").pop() === leccion)
if (!entry) throw new Error(`Lección no encontrada: ${leccion}`)

const leccionKey = entry.id.split("/").pop()!
const rutas = info.rutas
// Hide-until-ready: solo los cursos adaptables emiten el script anti-parpadeo.
const adaptativo = Boolean(rutas?.length)
// Render inicial (sin JS): la ruta por defecto Fácil · Hardware · Solo.
// Con JS, initCourseConfig repinta con la ruta activa del lector.
const leccionesDefecto = leccionesDeRuta(info, CONFIG_POR_DEFECTO)
const totalDefecto = leccionesDefecto.length
const modulosDefecto = new Set(leccionesDefecto.map((leccion) => leccion.modulo)).size
const entryNumero = entry.data.numero ?? ""
const catalogoJson = rutas
  ? JSON.stringify(
      info.lecciones.map((leccion) => ({
        slug: leccion.slug,
        numero: leccion.numero,
        title: leccion.title,
        modulo: leccion.modulo,
      })),
    ).replace(/</g, "\\u003c")
  : ""
const idx = leccionesDefecto.findIndex((item) => item.slug === leccionKey)
const prev = idx > 0 ? leccionesDefecto[idx - 1] : null
const next = idx >= 0 && idx < leccionesDefecto.length - 1 ? leccionesDefecto[idx + 1] : null
const currentModule = info.modulos.find((modulo) =>
  modulo.lecciones.some((item) => item.slug === leccionKey),
)
const currentSub = currentModule?.submodulos?.find((sub) =>
  sub.lecciones.some((item) => item.slug === leccionKey),
)

const { Content, headings } = await render(entry)
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const hasToc = tocItems.length >= 2
const base = site.base
const categoria = getCategoria(info.categoria)
const url = cursoUrl(info, base)
const esNivel = info.unidad === "nivel"
const etiqueta = esNivel ? "Nivel" : "Clase"
const numeroVisible = esNivel
  ? String(entry.data.orden)
  : entry.data.numero || String(entry.data.orden + 1).padStart(2, "0")
---

<BaseLayout titulo={`${entry.data.title} · ${info.titulo}`} descripcion={entry.data.description}>
  {adaptativo && <script is:inline define:vars={{ slug: info.slug }}>
    ;(function () {
      try {
        const d = localStorage.getItem("ncw:difficulty:" + slug) || "facil"
        const e = localStorage.getItem("ncw:environment:" + slug) || "hardware"
        const b = e === "vm" ? "solo" : localStorage.getItem("ncw:boot:" + slug) || "solo"
        if ([d, e, b].join("|") !== "facil|hardware|solo") {
          document.documentElement.classList.add("ncw-route-pending")
          setTimeout(function () {
            document.documentElement.classList.remove("ncw-route-pending")
          }, 3000)
        }
      } catch {}
    })()
  </script>}
  <div class="player-bar" data-pagefind-ignore="all">
    <div class="container-page player-bar__inner">
      <nav class="breadcrumb player-bar__crumb" aria-label="Miga de pan">
        <a href={`${base}cursos/`}>Cursos</a>
        <span aria-hidden="true">/</span>
        <a href={`${base}cursos/${info.categoria}/`}>{categoria?.titulo || info.categoria}</a>
        <span aria-hidden="true">/</span>
        <a href={url} class="player-bar__course">
          {info.titulo}
        </a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">
          {etiqueta} {numeroVisible} de <span data-lesson-total>{totalDefecto}</span>
        </span>
      </nav>

      <div class="player-bar__tools">
        <div class="player-bar__progress">
          <span id="player-progress-pct">0% completado</span>
          <span id="player-progress-count" class="player-bar__count">
            (<span id="player-progress-done">0</span> de{" "}
            <span data-lesson-total>{totalDefecto}</span>)
          </span>
        </div>
        <div class="progress-track player-bar__track" aria-hidden="true">
          <div id="player-progress-bar" class="progress-fill progress-fill--accent"></div>
        </div>
        <button type="button" id="temario-open" class="btn btn-ghost btn-sm">
          Temario <span aria-hidden="true">▤</span>
        </button>
      </div>
    </div>
  </div>

  <div class="container-page player-layout">
    <article class="player-main">
      {rutas && <CourseConfig curso={info} variant="lesson" />}
      {rutas && (
        <div class="route-notice" data-route-notice role="status" hidden>
          <p class="route-notice__text">
            Esta lección no está en tu ruta actual (
            <span data-route-notice-summary>Fácil · Hardware · Solo Linux</span>
            ).
          </p>
          <button type="button" class="route-notice__cta" data-route-notice-cta>
            Verla en la ruta que sí la incluye
          </button>
        </div>
      )}
      {"video" in entry.data && (
        <div class="player-frame">
          <div class="player-frame__bar">
            <span class="terminal__dots" aria-hidden="true">
              <span class="terminal__dot terminal__dot--red"></span>
              <span class="terminal__dot terminal__dot--yellow"></span>
              <span class="terminal__dot terminal__dot--green"></span>
            </span>
            <span class="terminal__title">
              monitor · {etiqueta.toLowerCase()} {numeroVisible}
            </span>
            <span class="player-frame__state">
              <span class="status-dot status-dot--cyan" aria-hidden="true"></span> registro de campo
            </span>
          </div>
          <VideoEmbed video={entry.data.video} titulo={entry.data.title} />
        </div>
      )}

      <header class="lesson-head sheet" data-pagefind-ignore="all">
        <div class="lesson-head__top">
          <div class="lesson-head__info">
            {currentModule && (
              <p class="lesson-head__module">
                <span class="signal">
                  M{currentModule.numero} · {currentModule.titulo}
                </span>
                {currentSub && (
                  <>
                    <span aria-hidden="true">/</span>
                    <span class="accent">
                      {currentSub.numero} · {currentSub.titulo}
                    </span>
                  </>
                )}
              </p>
            )}
            <p class="lesson-head__kicker">
              <span class="accent">
                {etiqueta} {numeroVisible}
              </span>
              <span aria-hidden="true">·</span>
              <span>
                {entry.data.video ? entry.data.duracion || "Video + guía" : "Guía escrita"}
              </span>
            </p>
            <h1 class="lesson-head__title">{entry.data.title}</h1>
          </div>

          <div class="lesson-head__arrows">
            <a
              href={prev ? leccionUrl(info, prev, base) : undefined}
              class="btn btn-secondary btn-sm"
              title={prev ? `Anterior: ${prev.title}` : "No hay lección anterior"}
              aria-label="Lección anterior"
              data-route-prev
              hidden={!prev}
            >
              <span aria-hidden="true">←</span>
            </a>
            <a
              href={next ? leccionUrl(info, next, base) : undefined}
              class="btn btn-primary btn-sm"
              title={next ? `Siguiente: ${next.title}` : "Fin de la ruta"}
              aria-label="Lección siguiente"
              data-route-next
              data-mark-next
              hidden={!next}
            >
              <span>Siguiente</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href={url} class="btn btn-primary btn-sm" data-route-back hidden={Boolean(next)}>
              <span>Volver al temario</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <p class="lesson-head__desc">{entry.data.description}</p>

        <div class="lesson-head__foot">
          <button
            id="marcar-completada"
            class="btn btn-ghost"
            type="button"
            data-slug={info.slug}
            data-leccion={leccionKey}
            aria-pressed="false"
          >
            <span class="btn-icon" aria-hidden="true">
              ○
            </span>
            <span class="btn-label">Marcar lección como completada</span>
          </button>
          <span class="meta">Se guarda automáticamente en tu navegador</span>
        </div>
      </header>

      <section class="lesson-guide sheet" aria-labelledby="guia-title">
        <div class="lesson-guide__head" data-pagefind-ignore="all">
          <span class="status-dot status-dot--cyan" aria-hidden="true"></span>
          <h2 id="guia-title">Guía escrita de la lección</h2>
          <span class="meta">Comandos y notas</span>
        </div>
        <div class="leccion">
          <Content />
        </div>
      </section>

      <nav class="lesson-nav" aria-label="Navegación entre lecciones" data-pagefind-ignore="all">
        <div
          class="lesson-nav__spacer"
          data-route-prev-spacer
          hidden={Boolean(prev)}
          aria-hidden="true"
        ></div>
        <a
          href={prev ? leccionUrl(info, prev, base) : undefined}
          class="lesson-nav__card sheet sheet--link"
          data-route-prev
          aria-label="Lección anterior"
          hidden={!prev}
        >
          <span class="lesson-nav__label">← {etiqueta} anterior</span>
          <span class="lesson-nav__title">{prev?.title ?? ""}</span>
        </a>

        <a
          href={next ? leccionUrl(info, next, base) : undefined}
          class="lesson-nav__card sheet sheet--link lesson-nav__card--next"
          data-route-next
          data-mark-next
          aria-label="Lección siguiente"
          hidden={!next}
        >
          <span class="lesson-nav__label">Siguiente {etiqueta.toLowerCase()} →</span>
          <span class="lesson-nav__title">{next?.title ?? ""}</span>
        </a>
        <a
          href={url}
          class="lesson-nav__card sheet sheet--link lesson-nav__card--next"
          data-route-back
          hidden={Boolean(next)}
        >
          <span class="lesson-nav__label signal">Fin del curso</span>
          <span class="lesson-nav__title">Volver al temario y repasar →</span>
        </a>
      </nav>
    </article>

    <!-- Temario: fixed block on desktop, drawer on mobile -->
    <aside class="player-aside" data-pagefind-ignore="all">
      <div class="player-aside__inner">
        <div class="temario" id="temario" role="complementary" aria-label="Temario del curso">
          <div class="temario-sheet">
            <div class="temario__head">
              <div>
                <h2 class="temario__title">
                  <span class="status-dot" aria-hidden="true"></span>
                  Temario
                </h2>
                <p class="temario__meta">
                  <span data-lesson-modules>{modulosDefecto} módulos</span>
                  {" · "}
                  <span data-lesson-total>{totalDefecto}</span>
                  {` ${esNivel ? "niveles" : "clases"}`}
                </p>
              </div>
              <button
                type="button"
                class="temario__close btn btn-ghost btn-sm"
                id="temario-close"
                aria-label="Cerrar temario"
              >
                <span aria-hidden="true">✕</span>
              </button>
            </div>

            <CourseModuleList
              modules={info.modulos}
              cursoBase={url}
              unidad={info.unidad}
              current={leccionKey}
              variant="sidebar"
            />

            <div class="temario__foot">
              <span>Curso completo</span>
              <a href={url}>Repasar el temario →</a>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <!-- TOC drawer (left side, floating) -->
  {hasToc && (
    <>
      <div class="toc-overlay" id="toc-overlay" aria-hidden="true"></div>
      <aside
        class="toc-drawer"
        id="toc-drawer"
        role="complementary"
        aria-label="Índice de la lección"
        inert
      >
        <div class="toc-drawer__head">
          <span class="docket">Índice</span>
          <button
            type="button"
            class="toc-drawer__close btn btn-ghost btn-sm"
            id="toc-close"
            aria-label="Cerrar índice"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
        <TableOfContents
          headings={headings}
          title="En esta lección"
          titleId="toc-drawer-title"
          variant="inline"
        />
      </aside>

      <!-- FAB buttons: TOC (left) and Temario (right) -->
      <button
        type="button"
        class="fab fab-toc"
        id="fab-toc"
        aria-controls="toc-drawer"
        aria-label="Abrir índice de la lección"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="14" y2="17" />
        </svg>
        <span class="fab__label">Índice</span>
      </button>
    </>
  )}

  <button type="button" class="fab fab-temario" id="fab-temario-mobile" aria-controls="temario">
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <line x1="9" y1="9" x2="15" y2="9" />
      <line x1="9" y1="13" x2="15" y2="13" />
      <line x1="9" y1="17" x2="12" y2="17" />
    </svg>
    Temario ·{" "}
    <span id="fab-temario-count">
      <span id="fab-done">0</span>/<span data-lesson-total>{totalDefecto}</span>
    </span>
  </button>

  {rutas && (
    <script
      type="application/json"
      id="arch-catalog"
      data-base={url}
      data-numero={entryNumero}
      set:html={catalogoJson}
    />
  )}

  <script>
    import {
      SET_CONFIG_EVENT,
      initCourseConfig,
      primeraRutaConLeccion,
      resumirConfig,
    } from "../../../../lib/course-config.client"
    import type { CourseConfigState } from "../../../../lib/course-config.client"
    import type { CursoConfig, CursoRuta } from "../../../../lib/tracks"

    interface CatalogoItem {
      slug: string
      numero: string
      title: string
      modulo: string
    }

    const catalogoEl = document.getElementById("arch-catalog")
    let catalogo: CatalogoItem[]
    try {
      catalogo = JSON.parse(catalogoEl?.textContent ?? "[]")
    } catch {
      catalogo = []
    }
    const base = catalogoEl?.getAttribute("data-base") ?? ""
    const entryNumero = catalogoEl?.getAttribute("data-numero") ?? ""
    const porNumero = new Map(catalogo.map((item: CatalogoItem) => [item.numero, item]))

    const configRoot = document.querySelector<HTMLElement>("[data-course-config]")
    let rutas: CursoRuta[]
    try {
      rutas = JSON.parse(configRoot?.getAttribute("data-rutas") ?? "[]")
    } catch {
      rutas = []
    }

    const notice = document.querySelector<HTMLElement>("[data-route-notice]")
    const noticeSummary = notice?.querySelector<HTMLElement>("[data-route-notice-summary]")
    const noticeCta = notice?.querySelector<HTMLElement>("[data-route-notice-cta]")

    let ultimaConfig: CursoConfig | undefined

    noticeCta?.addEventListener("click", () => {
      if (!configRoot) return
      const objetivo = primeraRutaConLeccion(rutas, entryNumero, ultimaConfig)
      if (!objetivo) return
      configRoot.dispatchEvent(
        new CustomEvent(SET_CONFIG_EVENT, {
          detail: {
            dificultad: objetivo.dificultad,
            entorno: objetivo.entorno,
            arranque: objetivo.arranque,
          },
        }),
      )
    })

    const aplicarEnlace = (
      el: HTMLElement,
      target: CatalogoItem | null | undefined,
      tipo: "prev" | "next",
    ) => {
      if (!target) {
        el.hidden = true
        return
      }
      el.hidden = false
      el.setAttribute("href", `${base}${target.slug}/`)
      el.setAttribute("title", `${tipo === "prev" ? "Anterior" : "Siguiente"}: ${target.title}`)
      el.setAttribute("aria-label", tipo === "prev" ? "Lección anterior" : "Lección siguiente")
      const titleEl = el.querySelector(".lesson-nav__title")
      if (titleEl) titleEl.textContent = target.title
    }

    initCourseConfig((state: CourseConfigState) => {
      if (!catalogoEl) return
      ultimaConfig = state.config
      if (noticeSummary) noticeSummary.textContent = resumirConfig(state.config)
      const visibles = state.ruta ? state.ruta.lecciones : []
      const i = visibles.indexOf(entryNumero)
      const inRuta = i !== -1
      const prev = inRuta && i > 0 ? porNumero.get(visibles[i - 1]) : null
      const next = inRuta && i < visibles.length - 1 ? porNumero.get(visibles[i + 1]) : null
      for (const el of document.querySelectorAll<HTMLElement>("[data-route-prev]"))
        aplicarEnlace(el, prev, "prev")
      for (const el of document.querySelectorAll<HTMLElement>("[data-route-next]"))
        aplicarEnlace(el, next, "next")
      const spacer = document.querySelector<HTMLElement>("[data-route-prev-spacer]")
      if (spacer) spacer.hidden = Boolean(prev)
      for (const el of document.querySelectorAll<HTMLElement>("[data-route-back]"))
        el.hidden = Boolean(next)
      if (notice) notice.hidden = inRuta
    })
  </script>

  <script
    is:inline
    define:vars={{ slug: info.slug, leccionKey, totalDefecto, tieneRutas: Boolean(rutas) }}
  >
    // Dificultad activa (persiste T3): localStorage saneado, default facil.
    const sanitizeDificultad = (value) => (value === "avanzada" ? "avanzada" : "facil")
    let dificultad = "facil"
    try {
      dificultad = sanitizeDificultad(localStorage.getItem(`ncw:difficulty:${slug}`))
    } catch {}
    // Denominador de la barra: total de la ruta activa; fallback al render SSR.
    const totalLecciones = totalDefecto
    let visiblesRuta = null

    const keyFor = () =>
      tieneRutas ? `ncw:progress:${slug}:${dificultad}` : `ncw:progress:${slug}`
    const routeTotal = () =>
      Array.isArray(visiblesRuta) && visiblesRuta.length ? visiblesRuta.length : totalLecciones
    const btn = document.getElementById("marcar-completada")
    const label = btn?.querySelector(".btn-label")
    const icon = btn?.querySelector(".btn-icon")

    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(keyFor()) || "[]")
      } catch {
        return []
      }
    }

    const syncUI = () => {
      const doneList = read()
      const isDone = doneList.includes(leccionKey)
      const count = doneList.length
      const pct = Math.min(100, Math.round((count / routeTotal()) * 100))

      if (btn) {
        btn.setAttribute("aria-pressed", String(isDone))
        if (label)
          label.textContent = isDone ? "Lección completada ✓" : "Marcar lección como completada"
        if (icon) icon.textContent = isDone ? "✓" : "○"
        btn.classList.toggle("btn-primary", isDone)
        btn.classList.toggle("btn-ghost", !isDone)
      }

      const pctEl = document.getElementById("player-progress-pct")
      const doneEl = document.getElementById("player-progress-done")
      const barEl = document.getElementById("player-progress-bar")
      if (pctEl) pctEl.textContent = `${pct}% completado`
      if (doneEl) doneEl.textContent = String(count)
      if (barEl) barEl.style.width = `${pct}%`

      const fabDone = document.getElementById("fab-done")
      if (fabDone) fabDone.textContent = String(count)

      for (const item of document.querySelectorAll("[data-lesson-item]")) {
        item.classList.toggle("is-done", doneList.includes(item.getAttribute("data-lesson-item")))
      }
      for (const mod of document.querySelectorAll("[data-module-key]")) {
        const items = [...mod.querySelectorAll("[data-lesson-item]")]
        const done = items.filter((item) =>
          doneList.includes(item.getAttribute("data-lesson-item")),
        ).length
        const doneEl = mod.querySelector("[data-module-done]")
        const fillEl = mod.querySelector("[data-module-fill]")
        if (doneEl) doneEl.textContent = `${done}/${items.length}`
        if (fillEl) {
          fillEl.style.width = items.length ? `${Math.round((done / items.length) * 100)}%` : "0%"
        }
      }
    }

    btn?.addEventListener("click", () => {
      const done = new Set(read())
      if (done.has(leccionKey)) {
        done.delete(leccionKey)
      } else {
        done.add(leccionKey)
      }
      try {
        localStorage.setItem(keyFor(), JSON.stringify([...done]))
      } catch {}
      syncUI()
    })

    const markCompleted = () => {
      const done = new Set(read())
      done.add(leccionKey)
      try {
        localStorage.setItem(keyFor(), JSON.stringify([...done]))
      } catch {}
    }

    for (const link of document.querySelectorAll("[data-mark-next]")) {
      link.addEventListener("click", markCompleted)
    }

    syncUI()

    // Seguir la config activa del configurador sin recargar: la dificultad fija
    // la clave de progreso y la ruta fija el denominador de la barra.
    const onConfig = (event) => {
      const detail = (event && event.detail) || {}
      dificultad = sanitizeDificultad(detail.config?.dificultad)
      visiblesRuta = Array.isArray(detail.visibles) ? detail.visibles : null
      syncUI()
    }
    document.addEventListener("ncw:course-config", onConfig)
    window.addEventListener("ncw:course-config", onConfig)

    const tocDrawer = document.getElementById("toc-drawer")
    const tocOverlay = document.getElementById("toc-overlay")
    const tocFab = document.getElementById("fab-toc")

    const closeTocDrawer = () => {
      if (tocDrawer) {
        tocDrawer.classList.remove("is-open")
        tocDrawer.inert = true
      }
      if (tocOverlay) tocOverlay.classList.remove("is-open")
      document.body.style.overflow = ""
    }

    const closeAllDrawers = () => {
      closeTocDrawer()
      setTemarioDrawer(false)
    }

    tocFab?.addEventListener("click", () => {
      setTemarioDrawer(false)
      tocDrawer?.classList.add("is-open")
      tocOverlay?.classList.add("is-open")
      if (tocDrawer) tocDrawer.inert = false
      document.body.style.overflow = "hidden"
    })

    document.getElementById("toc-close")?.addEventListener("click", closeAllDrawers)
    tocOverlay?.addEventListener("click", closeAllDrawers)

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeAllDrawers()
    })

    tocDrawer
      ?.querySelectorAll("a[href]")
      .forEach((link) => link.addEventListener("click", closeAllDrawers))

    // Temario drawer on mobile (opened from FAB or header button)
    const playerAside = document.querySelector(".player-aside")
    const temarioOverlayEl = document.createElement("div")
    temarioOverlayEl.className = "temario-mobile-overlay"
    temarioOverlayEl.style.cssText = `
      position: fixed; inset: 0; z-index: var(--z-overlay);
      background: rgba(0,0,0,0.5); opacity: 0; visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    `
    document.body.appendChild(temarioOverlayEl)

    const desktopQuery = window.matchMedia("(min-width: 1024px)")

    const setTemarioDrawer = (open) => {
      if (!playerAside) return
      playerAside.classList.toggle("is-open", open)
      playerAside.inert = !open && !desktopQuery.matches
      temarioOverlayEl.style.opacity = open ? "1" : "0"
      temarioOverlayEl.style.visibility = open ? "visible" : "hidden"
      document.body.style.overflow = open ? "hidden" : ""
    }

    const syncTemarioMode = () => {
      if (desktopQuery.matches) {
        setTemarioDrawer(false)
      } else if (playerAside) {
        playerAside.inert = !playerAside.classList.contains("is-open")
      }
    }
    desktopQuery.addEventListener("change", syncTemarioMode)
    syncTemarioMode()

    document.getElementById("fab-temario-mobile")?.addEventListener("click", () => {
      closeTocDrawer()
      setTemarioDrawer(true)
    })
    document.getElementById("temario-open")?.addEventListener("click", () => {
      closeTocDrawer()
      setTemarioDrawer(true)
    })
    document
      .getElementById("temario-close")
      ?.addEventListener("click", () => setTemarioDrawer(false))
    temarioOverlayEl.addEventListener("click", () => setTemarioDrawer(false))
    playerAside
      ?.querySelectorAll("a[href]")
      .forEach((link) => link.addEventListener("click", () => setTemarioDrawer(false)))

    const modulesKey = `ncw:modules:${slug}`
    const readOpen = () => {
      try {
        const value = JSON.parse(localStorage.getItem(modulesKey) || "null")
        return Array.isArray(value) ? value : null
      } catch {
        return null
      }
    }
    const persistOpen = () => {
      const openKeys = [...document.querySelectorAll(".sy-module[open]")].map((item) =>
        item.getAttribute("data-module-key"),
      )
      try {
        localStorage.setItem(modulesKey, JSON.stringify(openKeys))
      } catch {}
    }
    const savedOpen = readOpen()
    document.querySelectorAll(".sy-module").forEach((item) => {
      if (savedOpen) item.open = savedOpen.includes(item.getAttribute("data-module-key"))
      item.addEventListener("toggle", persistOpen)
    })
    const currentModuleEl = document.querySelector(".sy-item.is-current")?.closest(".sy-module")
    if (currentModuleEl) {
      currentModuleEl.open = true
      persistOpen()
    }

    const iframe = document.getElementById("lesson-video")
    for (const chapter of document.querySelectorAll(".sy-chapter[data-seek]")) {
      chapter.addEventListener("click", () => {
        const time = Number.parseInt(chapter.getAttribute("data-seek") || "0", 10)
        iframe?.contentWindow?.postMessage(
          JSON.stringify({ event: "command", func: "seekTo", args: [time, true] }),
          "*",
        )
      })
    }
  </script>
</BaseLayout>


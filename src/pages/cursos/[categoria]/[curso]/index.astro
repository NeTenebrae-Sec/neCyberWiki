---
import BaseLayout from "../../../../layouts/BaseLayout.astro"
import CourseModuleList from "../../../../components/CourseModuleList.astro"
import CourseConfig from "../../../../components/CourseConfig.astro"
import {
  cursoUrl,
  getCursoPublicado,
  getCursosPublicados,
  leccionUrl,
  leccionesDeRuta,
} from "../../../../lib/catalog"
import { CONFIG_POR_DEFECTO } from "../../../../lib/tracks"
import { REGLA_DE_CAMPO, fichaDeRuta, formatoDeRuta } from "../../../../lib/course-config.client"
import { getCategoria } from "../../../../data/categorias"
import { site } from "../../../../data/site"

export async function getStaticPaths() {
  const cursos = await getCursosPublicados()
  return cursos.map((curso) => ({
    params: { categoria: curso.categoria, curso: curso.slug },
  }))
}

const { categoria: categoriaId, curso: cursoSlug } = Astro.params
const info = await getCursoPublicado(cursoSlug!)
if (!info) throw new Error(`Curso no publicado: ${cursoSlug}`)
if (info.categoria !== categoriaId) {
  throw new Error(`El curso ${info.slug} no pertenece a la categoría ${categoriaId}`)
}

const categoria = getCategoria(info.categoria)
const base = site.base
const url = cursoUrl(info, base)
const videosEnPreparacion = info.videoPendiente === true
// Render inicial (sin JS): ruta por defecto Fácil · Hardware · Solo.
const leccionesDefecto = leccionesDeRuta(info, CONFIG_POR_DEFECTO)
const totalDefecto = leccionesDefecto.length
const modulosDefecto = new Set(leccionesDefecto.map((leccion) => leccion.modulo)).size
const primeraDefecto = leccionesDefecto[0]
const primeraUrl = primeraDefecto ? leccionUrl(info, primeraDefecto, base) : url
const unidad = info.unidad === "nivel" ? "niveles" : "lecciones"
const etiquetaUnidad = info.unidad === "nivel" ? "nivel" : "clase"
// Hide-until-ready: solo los cursos adaptables emiten el script anti-parpadeo.
const adaptativo = Boolean(info.rutas?.length)
const leccionesJson = JSON.stringify(leccionesDefecto.map((leccion) => leccion.slug))
// Ficha adaptable: SSR pinta la ruta por defecto (Fácil · Hardware · Solo).
const fichaDefecto = fichaDeRuta(CONFIG_POR_DEFECTO)
const formatoDefecto = formatoDeRuta(totalDefecto, info.lecciones.length)
---

<BaseLayout titulo={info.titulo} descripcion={info.descripcion}>
  {adaptativo && <script is:inline define:vars={{ slug: info.slug }}>
    ;(function () {
      try {
        const d = localStorage.getItem("ncw:difficulty:" + slug) || "facil"
        const e = localStorage.getItem("ncw:environment:" + slug) || "hardware"
        const b = e === "vm" ? "solo" : localStorage.getItem("ncw:boot:" + slug) || "solo"
        if ([d, e, b].join("|") !== "facil|hardware|solo") {
          document.documentElement.classList.add("ncw-route-pending")
          setTimeout(function () {
            document.documentElement.classList.remove("ncw-route-pending")
          }, 3000)
        }
      } catch {}
    })()
  </script>}
  <section class="course-hero">
    <div class="container-page">
      <nav class="breadcrumb" aria-label="Miga de pan">
        <a href={`${base}cursos/`}>Cursos</a>
        <span aria-hidden="true">/</span>
        {categoria && (
          <>
            <a href={`${base}cursos/${categoria.id}/`}>{categoria.titulo}</a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span aria-current="page">{info.titulo}</span>
      </nav>

      <div class="course-hero__grid">
        <div class="course-hero__main">
          <div class="course-hero__docket">
            <span class="docket">
              {categoria ? `Ruta ${categoria.indice}` : "Curso"} · <strong>{info.nivel}</strong>
            </span>
            <span class="chip chip--signal">
              <span class="status-dot" aria-hidden="true"></span>
              Guía publicada
            </span>
          </div>

          <h1 class="course-hero__title">{info.titulo}</h1>
          {info.hero ? (
            <div class="course-hero__editorial">
              {info.hero.copy.map((parrafo) => (
                <p class="course-hero__intro">{parrafo}</p>
              ))}
            </div>
          ) : (
            <p class="lead course-hero__promise">{info.promesa}</p>
          )}

          {videosEnPreparacion && (
            <>
              <div class="course-hero__video" data-pagefind-ignore="all">
                <span class="course-hero__video-sello">
                  <span class="status-dot" aria-hidden="true"></span>
                  INTRO · EN PREPARACIÓN
                </span>
                <span class="course-hero__play" aria-hidden="true">
                  ▶
                </span>
              </div>
              <p class="course-hero__video-caption">Guía escrita disponible desde ya</p>
            </>
          )}

          <div class="course-hero__meta" data-pagefind-ignore="all">
            <span data-course-total data-unidad={unidad}>
              {totalDefecto} {unidad}
            </span>
            <span data-course-modules data-unidad="módulos">
              {modulosDefecto} módulos
            </span>
            <span>
              {videosEnPreparacion ? "Guía escrita · videos en preparación" : "Guía escrita"}
            </span>
            <span>Progreso local</span>
          </div>

          <CourseConfig curso={info} variant="hero" />
          {info.rutas && (
            <p class="course-route" data-course-route data-route-only>
              Ruta: Fácil · Hardware · Solo Linux
            </p>
          )}
          {info.rutas && (
            <noscript>
              <p class="course-noscript">
                Activa JavaScript para adaptar el temario; abajo están todas las lecciones.
              </p>
            </noscript>
          )}

          <div
            class="mission-meter sheet sheet--flat"
            data-progress-course={info.slug}
            data-progress-total={totalDefecto}
            data-unidad={unidad}
            data-pagefind-ignore="all"
          >
            <div class="mission-meter__head">
              <span class="status">
                <span class="status-dot" aria-hidden="true"></span>
                Tu avance en el curso
              </span>
              <strong data-progress-label>
                0 / {totalDefecto} {unidad}
              </strong>
            </div>
            <div
              class="progress-track"
              role="progressbar"
              aria-label="Progreso del curso"
              aria-valuemin="0"
              aria-valuemax={totalDefecto}
              aria-valuenow="0"
            >
              <div class="progress-fill" data-progress-fill></div>
            </div>
            <p class="mission-meter__note">Guardado solo en este navegador. Sin cuentas.</p>
          </div>

          {info.hero?.cta && <p class="course-hero__cta-note">{info.hero.cta}</p>}

          <div class="course-hero__actions" data-pagefind-ignore="all">
            {primeraDefecto && (
              <a
                href={primeraUrl}
                id="cta-continue"
                class="btn btn-primary btn-hud course-hero__start"
                data-lessons={leccionesJson}
                data-base={url}
                data-unidad={etiquetaUnidad}
              >
                <span>Empezar {info.unidad === "nivel" ? "por el nivel 0" : "la clase 1"}</span>
                <span class="course-hero__start-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
            <a href="#temario" class="course-hero__link">
              <span>Ver temario</span>
              <span class="course-hero__link-arrow" aria-hidden="true">
                ↓
              </span>
            </a>
          </div>
        </div>

        <aside class="course-aside sheet sheet--cut" aria-labelledby="course-aside-title">
          <span class="tape course-aside__tape" aria-hidden="true"></span>
          <h2 id="course-aside-title" class="course-aside__title">
            Ficha del curso
          </h2>

          {adaptativo ? (
            <div data-ficha-adaptable data-ficha-total={info.lecciones.length} aria-live="polite">
              <div class="course-aside__block" data-route-only>
                <p class="course-aside__label">Qué necesitas</p>
                <ul class="course-aside__req" data-ficha-necesitas>
                  {fichaDefecto.necesitas.map((requisito) => (
                    <li>
                      <span aria-hidden="true">▹</span>
                      {requisito}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="course-aside__block" data-route-only>
                <p class="course-aside__label">Qué vas a saber</p>
                <ul class="course-aside__req" data-ficha-sabes>
                  {fichaDefecto.sabes.map((resultado) => (
                    <li>
                      <span aria-hidden="true">▹</span>
                      {resultado}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="course-aside__block" data-route-only>
                <p class="course-aside__label">Formato</p>
                <p class="course-aside__text" data-ficha-formato>
                  {formatoDefecto}
                </p>
              </div>
            </div>
          ) : (
            <>
              <div class="course-aside__block">
                <p class="course-aside__label">Qué necesitas</p>
                <ul class="course-aside__req">
                  {info.requisitos.map((requisito) => (
                    <li>
                      <span aria-hidden="true">▹</span>
                      {requisito}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="course-aside__block">
                <p class="course-aside__label">Qué vas a saber</p>
                <ul class="course-aside__req">
                  {info.resultados.map((resultado) => (
                    <li>
                      <span aria-hidden="true">▹</span>
                      {resultado}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="course-aside__block">
                <p class="course-aside__label">Formato</p>
                <p class="course-aside__text">
                  {videosEnPreparacion ? (
                    <>
                      <span data-course-aside-total data-unidad={unidad}>
                        {totalDefecto} {unidad} en tu ruta
                      </span>
                      {` · ${info.lecciones.length} lecciones únicas · videos en preparación`}
                    </>
                  ) : (
                    <>
                      {totalDefecto} {unidad} en {info.modulos.length} módulos, con guía escrita,
                      comandos y explicación del razonamiento. Sin videos prometidos.
                    </>
                  )}
                </p>
              </div>
            </>
          )}

          {info.fuente && (
            <div class="course-aside__block">
              <p class="course-aside__label">Laboratorio original</p>
              <p class="course-aside__text">
                <a href={info.fuente.url} target="_blank" rel="noopener">
                  {info.fuente.nombre} <span aria-hidden="true">↗</span>
                </a>
              </p>
            </div>
          )}

          <div class="course-aside__block course-aside__block--last">
            <p class="course-aside__label">Regla de campo</p>
            <p class="course-aside__text">
              {adaptativo
                ? REGLA_DE_CAMPO
                : "Practica en una máquina virtual, en hardware propio o en el laboratorio autorizado del curso. Nunca en sistemas ajenos."}
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="course-syllabus" id="temario">
    <div class="container-page">
      <div class="course-syllabus__head">
        <div>
          <p class="label-rule">Temario del curso</p>
          <h2 class="course-syllabus__title">Módulos y {unidad}.</h2>
        </div>
        <span class="meta">
          <span data-course-modules data-unidad="módulos">
            {modulosDefecto} módulos
          </span>
          {` · `}
          <span data-course-total data-unidad={unidad}>
            {totalDefecto} {unidad}
          </span>
          {videosEnPreparacion ? " · videos en preparación" : " · guía escrita"}
        </span>
      </div>

      <CourseModuleList
        modules={info.modulos}
        cursoBase={url}
        unidad={info.unidad}
        variant="page"
      />
    </div>
  </section>

  <script>
    import {
      fichaDeRuta,
      formatoDeRuta,
      initCourseConfig,
    } from "../../../../lib/course-config.client"
    import { progresoKey } from "../../../../lib/tracks"

    const pintarLista = (lista: Element | null, items: string[]) => {
      if (!lista) return
      lista.replaceChildren(
        ...items.map((texto) => {
          const li = document.createElement("li")
          const marca = document.createElement("span")
          marca.setAttribute("aria-hidden", "true")
          marca.textContent = "▹"
          li.append(marca, document.createTextNode(texto))
          return li
        }),
      )
    }

    initCourseConfig((state) => {
      // Ficha adaptable: «Qué necesitas», «Qué vas a saber» y «Formato» se
      // repintan con la config y el total de la ruta activa (T8c).
      const ficha = document.querySelector<HTMLElement>("[data-ficha-adaptable]")
      if (ficha) {
        const copy = fichaDeRuta(state.config)
        pintarLista(ficha.querySelector("[data-ficha-necesitas]"), copy.necesitas)
        pintarLista(ficha.querySelector("[data-ficha-sabes]"), copy.sabes)
        const formato = ficha.querySelector<HTMLElement>("[data-ficha-formato]")
        const totalCurso = Number(ficha.getAttribute("data-ficha-total") || 0)
        if (formato) formato.textContent = formatoDeRuta(state.visibles.length, totalCurso)
      }

      const key = state.ruta
        ? progresoKey(state.slug, state.config.dificultad)
        : progresoKey(state.slug)
      let done: string[] = []
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || "[]")
        if (Array.isArray(parsed)) done = parsed.filter((item) => typeof item === "string")
      } catch {}

      // Aside de progreso: fila de la dificultad activa (denominador = ruta
      // activa). Se actualiza en cada cambio de config, sin recargar.
      const root = document.querySelector<HTMLElement>(`[data-progress-course="${state.slug}"]`)
      if (root) {
        const visibles = state.ruta ? state.visibles : null
        const total = visibles
          ? visibles.length
          : Number(root.getAttribute("data-progress-total") || 0)
        const marked = visibles ? visibles.filter((slug) => done.includes(slug)) : done
        const n = marked.length
        const pct = total > 0 ? Math.min(100, Math.round((n / total) * 100)) : 0
        const unidad = root.getAttribute("data-unidad") || "lecciones"
        root.setAttribute("data-progress-total", String(total))
        const label = root.querySelector("[data-progress-label]")
        if (label) label.textContent = `${n} / ${total} ${unidad} (${pct}%)`
        const fill = root.querySelector<HTMLElement>("[data-progress-fill]")
        if (fill) fill.style.width = `${pct}%`
        const bar = root.querySelector('[role="progressbar"]')
        bar?.setAttribute("aria-valuenow", String(n))
        bar?.setAttribute("aria-valuemax", String(total))
      }

      const cta = document.getElementById("cta-continue")
      if (!cta) return

      const base = cta.getAttribute("data-base") || ""
      const etiqueta = cta.getAttribute("data-unidad") || "clase"
      const visibles = state.visibles
      cta.setAttribute("data-lessons", JSON.stringify(visibles))

      const ctaLabel = cta.querySelector("span:first-child")
      const siguiente = visibles.find((slug) => !done.includes(slug))
      const etiquetaInicio = etiqueta === "nivel" ? "Empezar por el nivel 0" : "Empezar la clase 1"
      if (siguiente) {
        const idx = visibles.indexOf(siguiente)
        cta.setAttribute("href", `${base}${siguiente}/`)
        if (ctaLabel) {
          ctaLabel.textContent =
            done.length === 0 ? etiquetaInicio : `Continuar · ${etiqueta} ${idx + 1}`
        }
      } else if (visibles.length) {
        cta.setAttribute("href", `${base}${visibles[0]}/`)
        if (ctaLabel) ctaLabel.textContent = "Curso completado · Repasar desde el inicio"
      }
    })
  </script>

  <script
    is:inline
    define:vars={{ slug: info.slug, total: totalDefecto, unidad, tieneRutas: Boolean(info.rutas) }}
  >
    try {
      // Clave de progreso de la fila activa (default facil si no hay dificultad guardada).
      const sanitize = (value) => (value === "avanzada" ? "avanzada" : "facil")
      let dificultad = "facil"
      try {
        dificultad = sanitize(localStorage.getItem(`ncw:difficulty:${slug}`))
      } catch {}
      const key = tieneRutas ? `ncw:progress:${slug}:${dificultad}` : `ncw:progress:${slug}`
      const done = JSON.parse(localStorage.getItem(key) || "[]")
      const marks = Array.isArray(done) ? done : []
      const n = marks.length
      const pct = Math.round((n / total) * 100)

      const root = document.querySelector(`[data-progress-course="${slug}"]`)
      if (root) {
        root.querySelector("[data-progress-label]").textContent =
          `${n} / ${total} ${unidad} (${pct}%)`
        root.querySelector("[data-progress-fill]").style.width = `${pct}%`
        root.querySelector('[role="progressbar"]')?.setAttribute("aria-valuenow", String(n))
      }

      const cta = document.getElementById("cta-continue")
      if (cta) {
        const lessons = JSON.parse(cta.getAttribute("data-lessons") || "[]")
        const baseHref = cta.getAttribute("data-base") || ""
        const etiqueta = cta.getAttribute("data-unidad") || "clase"
        const nextSlug = lessons.find((lesson) => !marks.includes(lesson))
        if (nextSlug) {
          const nextIndex = lessons.indexOf(nextSlug)
          cta.setAttribute("href", `${baseHref}${nextSlug}/`)
          cta.querySelector("span:first-child").textContent =
            n === 0
              ? etiqueta === "nivel"
                ? "Empezar por el nivel 0"
                : "Empezar la clase 1"
              : `Continuar · ${etiqueta} ${nextIndex}`
        } else {
          cta.querySelector("span:first-child").textContent =
            "Curso completado · Repasar desde el inicio"
        }
      }

      for (const item of document.querySelectorAll("[data-lesson-item]")) {
        item.classList.toggle("is-done", marks.includes(item.getAttribute("data-lesson-item")))
      }
      for (const mod of document.querySelectorAll("[data-module-key]")) {
        const items = [...mod.querySelectorAll("[data-lesson-item]")]
        const doneCount = items.filter((item) =>
          marks.includes(item.getAttribute("data-lesson-item")),
        ).length
        const doneEl = mod.querySelector("[data-module-done]")
        const fillEl = mod.querySelector("[data-module-fill]")
        if (doneEl) doneEl.textContent = `${doneCount}/${items.length}`
        if (fillEl) {
          fillEl.style.width = items.length
            ? `${Math.round((doneCount / items.length) * 100)}%`
            : "0%"
        }
      }
    } catch {}
  </script>
</BaseLayout>

<style>
  .course-hero {
    position: relative;
    padding-block: clamp(1.25rem, 3vw, 2.25rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .course-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 1px 1px, var(--line) 0.7px, transparent 0.8px);
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
    opacity: 0.55;
  }

  .course-hero .container-page {
    position: relative;
    z-index: 1;
  }

  .course-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: 1.5rem;
  }

  .course-hero__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .course-hero__title {
    margin-top: 0.9rem;
    max-width: 22ch;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .course-hero__promise {
    margin-top: 1rem;
    max-width: 54ch;
  }

  .course-hero__editorial {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 56ch;
  }

  .course-hero__intro {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .course-hero__video {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 25rem;
    margin-top: 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    overflow: hidden;
  }

  .course-hero__video-sello {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .course-hero__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg-card);
    color: var(--accent);
    font-size: 0.8rem;
    line-height: 1;
  }

  .course-hero__video-caption {
    margin-top: 0.6rem;
    max-width: 25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--ink-dim);
  }

  .course-hero__cta-note {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .course-route {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--ink-dim);
  }

  .course-noscript {
    margin-top: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px dashed var(--line-strong);
    color: var(--ink-muted);
    font-size: 0.78rem;
  }

  .course-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .mission-meter {
    max-width: 34rem;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
  }

  .mission-meter__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-dim);
  }


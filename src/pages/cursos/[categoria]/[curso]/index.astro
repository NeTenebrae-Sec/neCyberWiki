---
import BaseLayout from "../../../../layouts/BaseLayout.astro"
import CourseFormatBar from "../../../../components/CourseFormatBar.astro"
import CourseModuleList from "../../../../components/CourseModuleList.astro"
import CourseConfig from "../../../../components/CourseConfig.astro"
import VideoEmbed from "../../../../components/VideoEmbed.astro"
import {
  cursoUrl,
  getCursoPublicado,
  getCursosPublicados,
  leccionUrl,
  leccionesDeRuta,
} from "../../../../lib/catalog"
import {
  buscarRuta,
  CONFIG_POR_DEFECTO,
  numerosVisiblesPorRuta,
  progresoKey,
} from "../../../../lib/tracks"
import { REGLA_DE_CAMPO, fichaDeRuta } from "../../../../lib/course-config.client"
import { getCategoria } from "../../../../data/categorias"
import { site } from "../../../../data/site"

export async function getStaticPaths() {
  const cursos = await getCursosPublicados()
  return cursos.map((curso) => ({
    params: { categoria: curso.categoria, curso: curso.slug },
  }))
}

const { categoria: categoriaId, curso: cursoSlug } = Astro.params
const info = await getCursoPublicado(cursoSlug!)
if (!info) throw new Error(`Curso no publicado: ${cursoSlug}`)
if (info.categoria !== categoriaId) {
  throw new Error(`El curso ${info.slug} no pertenece a la categoría ${categoriaId}`)
}

const categoria = getCategoria(info.categoria)
const base = site.base
const url = cursoUrl(info, base)
const videosEnPreparacion = info.videoPendiente === true
const videoIntro = info.hero?.video ?? ""
const videoIntroTitulo = `${info.titulo} · Introducción`
const mostrarVideoHero = videosEnPreparacion || videoIntro !== ""
// Render inicial (sin JS): ruta por defecto Fácil · Hardware · Solo.
const leccionesDefecto = leccionesDeRuta(info, CONFIG_POR_DEFECTO)
const totalDefecto = leccionesDefecto.length
const modulosDefecto = new Set(leccionesDefecto.map((leccion) => leccion.modulo)).size
const primeraDefecto = leccionesDefecto[0]
const rutaDefecto = info.rutas?.length ? buscarRuta(info.rutas, CONFIG_POR_DEFECTO) : undefined
const numerosVisiblesDefecto = numerosVisiblesPorRuta(rutaDefecto)
const primeraUrl = primeraDefecto ? leccionUrl(info, primeraDefecto, base) : url
const unidad = info.unidad === "nivel" ? "niveles" : "lecciones"
const etiquetaUnidad = info.unidad === "nivel" ? "nivel" : "clase"
// Hide-until-ready: solo los cursos adaptables emiten el script anti-parpadeo.
const adaptativo = Boolean(info.rutas?.length)
const leccionesJson = JSON.stringify(leccionesDefecto.map((leccion) => leccion.slug))
const progresoBase = progresoKey(info.slug)
// Ficha adaptable: SSR pinta la ruta por defecto (Fácil · Hardware · Solo).
const fichaDefecto = fichaDeRuta(CONFIG_POR_DEFECTO)
---

<BaseLayout titulo={info.titulo} descripcion={info.descripcion}>
  <section class="course-hero">
    <div class="container-page">
      <div class="course-hero__top-bar">
        <nav class="breadcrumb" aria-label="Miga de pan">
          <a href={`${base}cursos/`}>Cursos</a>
          <span aria-hidden="true">/</span>
          {categoria && (
            <>
              <a href={`${base}cursos/${categoria.id}/`}>{categoria.titulo}</a>
              <span aria-hidden="true">/</span>
            </>
          )}
          <span aria-current="page">{info.titulo}</span>
        </nav>
      </div>

      <div class="course-hero__grid">
        <div class="course-hero__main">
          <CourseFormatBar
            slug={info.slug}
            total={totalDefecto}
            modulos={modulosDefecto}
            unidad={unidad}
          />
          <h1 class="course-hero__title">{info.titulo}</h1>

          {mostrarVideoHero && (
            <div class="course-hero__video-hud" data-pagefind-ignore="all">
              <div class="video-hud__top">
                <div class="video-hud__status">
                  <span class="status-dot status-dot--cyan" aria-hidden="true"></span>
                  <span class="video-hud__status-text">INTRODUCCIÓN Y PANORAMA DEL CURSO</span>
                </div>
                <div class="video-hud__badges">
                  <span class="video-hud__badge video-hud__badge--accent">INTRO</span>
                </div>
              </div>

              <div class="video-hud__stage">
                <VideoEmbed video={videoIntro} titulo={videoIntroTitulo} />
                <div class="video-hud__timeline" aria-hidden="true">
                  <div class="video-hud__timeline-bar"></div>
                </div>
              </div>

              <div class="video-hud__bottom">
                <span class="video-hud__caption">
                  INTRODUCCIÓN:{" "}
                  <span class="video-hud__caption-highlight">Como funciona la neCyberWiki</span>
                </span>
                <a href="#temario" class="video-hud__bottom-link">
                  [ VER GUÍA ESCRITA ↓ ]
                </a>
              </div>
            </div>
          )}

          {info.hero ? (
            <div class="course-hero__editorial">
              {info.hero.copy.map((parrafo) => (
                <p class="course-hero__intro">{parrafo}</p>
              ))}
            </div>
          ) : (
            <p class="lead course-hero__promise">{info.promesa}</p>
          )}

          <CourseConfig curso={info} variant="hero" />
          {info.rutas && (
            <div class="course-hero__community-slot" aria-hidden="true" data-pagefind-ignore></div>
          )}
          {info.rutas && (
            <noscript>
              <p class="course-noscript">
                Activa JavaScript para adaptar el temario; abajo están todas las lecciones.
              </p>
            </noscript>
          )}

          {info.hero?.cta && <p class="course-hero__cta-note">{info.hero.cta}</p>}

          <div class="course-hero__actions" data-pagefind-ignore="all">
            {primeraDefecto && (
              <a
                href={primeraUrl}
                id="cta-continue"
                class="btn btn-primary btn-hud course-hero__start"
                data-lessons={leccionesJson}
                data-base={url}
                data-unidad={etiquetaUnidad}
              >
                <span>Empezar {info.unidad === "nivel" ? "por el nivel 0" : "la clase 1"}</span>
                <span class="course-hero__start-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
            <a href="#temario" class="btn btn-secondary btn-hud course-hero__secondary">
              <span>Ver temario completo</span>
              <span class="course-hero__link-arrow" aria-hidden="true">
                ↓
              </span>
            </a>
          </div>
        </div>

        {adaptativo ? (
          <aside
            class="course-ficha-hud"
            aria-labelledby="course-ficha-title"
            data-ficha-adaptable
            data-ficha-total={info.lecciones.length}
          >
            <div class="ficha-hud__head">
              <div class="ficha-hud__title-wrap">
                <span class="ficha-hud__indicator" aria-hidden="true" />
                <h2 id="course-ficha-title" class="ficha-hud__title">
                  REQUISITOS
                </h2>
              </div>
              <span class="ficha-hud__badge" data-ficha-route-badge>
                HARDWARE · SOLO LINUX
              </span>
            </div>

            {/* Dynamic Requirements List */}
            <div class="ficha-hud__req-list" data-ficha-necesitas-hud>
              {fichaDefecto.necesitas.map((req) => (
                <div class="ficha-hud__req-item">
                  <span class="status-dot status-dot--cyan" aria-hidden="true" />
                  <span class="ficha-hud__req-text">{req}</span>
                </div>
              ))}
            </div>

            {/* Dynamic Security / Warning Alert */}
            <div class="ficha-hud__warning ficha-hud__warning--danger" data-ficha-warning>
              <span class="ficha-hud__warning-icon" data-ficha-warning-icon aria-hidden="true">
                ▲
              </span>
              <div class="ficha-hud__warning-content">
                <strong class="ficha-hud__warning-title" data-ficha-warning-title>
                  ¡HAZ UN RESPALDO!
                </strong>
                <p class="ficha-hud__warning-desc" data-ficha-warning-desc>
                  Esta ruta formateará el disco completo. Todo dato previo en el equipo será
                  eliminado.
                </p>
              </div>
            </div>

            {/* Qué vas a saber */}
            <div class="ficha-hud__block">
              <p class="ficha-hud__block-label">QUÉ VAS A APRENDER:</p>
              <ul class="ficha-hud__learn-list" data-ficha-sabes>
                {fichaDefecto.sabes.map((item) => (
                  <li>
                    <span class="ficha-hud__learn-arrow" aria-hidden="true">
                      ▸
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* Regla de campo */}
            <div class="ficha-hud__rule">
              <p class="ficha-hud__rule-label">REGLA DE CAMPO:</p>
              <p class="ficha-hud__rule-text">{REGLA_DE_CAMPO}</p>
            </div>
          </aside>
        ) : (
          <aside class="course-aside sheet sheet--cut" aria-labelledby="course-aside-title">
            <span class="tape course-aside__tape" aria-hidden="true" />
            <h2 id="course-aside-title" class="course-aside__title">
              Ficha del curso
            </h2>

            <div class="course-aside__block">
              <p class="course-aside__label">Qué necesitas</p>
              <ul class="course-aside__req">
                {info.requisitos.map((requisito) => (
                  <li>
                    <span aria-hidden="true">▹</span>
                    {requisito}
                  </li>
                ))}
              </ul>
            </div>

            <div class="course-aside__block">
              <p class="course-aside__label">Qué vas a saber</p>
              <ul class="course-aside__req">
                {info.resultados.map((resultado) => (
                  <li>
                    <span aria-hidden="true">▹</span>
                    {resultado}
                  </li>
                ))}
              </ul>
            </div>

            <div class="course-aside__block">
              <p class="course-aside__label">Formato</p>
              <p class="course-aside__text">
                {videosEnPreparacion ? (
                  <>
                    <span data-course-aside-total data-unidad={unidad}>
                      {totalDefecto} {unidad} en tu ruta
                    </span>
                    {` · ${info.lecciones.length} lecciones únicas · videos en preparación`}
                  </>
                ) : (
                  <>
                    {totalDefecto} {unidad} en {info.modulos.length} módulos, con guía escrita,
                    comandos y explicación del razonamiento. Sin videos prometidos.
                  </>
                )}
              </p>
            </div>

            {info.fuente && (
              <div class="course-aside__block">
                <p class="course-aside__label">Laboratorio original</p>
                <p class="course-aside__text">
                  <a href={info.fuente.url} target="_blank" rel="noopener">
                    {info.fuente.nombre} <span aria-hidden="true">↗</span>
                  </a>
                </p>
              </div>
            )}

            <div class="course-aside__block course-aside__block--last">
              <p class="course-aside__label">Regla de campo</p>
              <p class="course-aside__text">
                Practica en una máquina virtual, en hardware propio o en el laboratorio autorizado
                del curso. Nunca en sistemas ajenos.
              </p>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <section class="course-syllabus" id="temario">
    <div class="container-page">
      <div class="course-syllabus__head">
        <div>
          <p class="label-rule">Temario del curso</p>
          <h2 class="course-syllabus__title">Módulos y {unidad}.</h2>
        </div>
        <span class="meta">
          <span data-course-modules data-unidad="módulos">
            {modulosDefecto} módulos
          </span>
          {` · `}
          <span data-course-total data-unidad={unidad}>
            {totalDefecto} {unidad}
          </span>
          {videosEnPreparacion ? " · videos en preparación" : " · guía escrita"}
        </span>
      </div>

      <div
        class="mission-meter sheet sheet--flat"
        data-progress-course={info.slug}
        data-progress-total={totalDefecto}
        data-unidad={unidad}
        data-pagefind-ignore="all"
      >
        <div class="mission-meter__head">
          <span class="status">
            <span class="status-dot" aria-hidden="true"></span>
            Tu avance en el curso
          </span>
          <strong data-progress-label>
            0 / {totalDefecto} {unidad}
          </strong>
        </div>
        <div
          class="progress-track"
          role="progressbar"
          aria-label="Progreso del curso"
          aria-valuemin="0"
          aria-valuemax={totalDefecto}
          aria-valuenow="0"
        >
          <div class="progress-fill" data-progress-fill></div>
        </div>
        <p class="mission-meter__note">Guardado solo en este navegador. Sin cuentas.</p>
      </div>

      <CourseModuleList
        modules={info.modulos}
        cursoBase={url}
        unidad={info.unidad}
        variant="page"
        routeNumbers={numerosVisiblesDefecto}
      />
    </div>
  </section>

  <script>
    import {
      fichaDeRuta,
      formatoDeRuta,
      initCourseConfig,
    } from "../../../../lib/course-config.client"
    import { progresoKey } from "../../../../lib/tracks"

    // Astro escopa el CSS con el atributo data-astro-cid-<hash>: los nodos creados
    // en runtime (createElement + className) no lo traen, asi que el selector escopado
    // deja de matchear y el repintado post-hidratacion se ve sin estilos.
    const heredarScope = (el: Element, origen: Element): void => {
      for (const atributo of Array.from(origen.attributes)) {
        if (atributo.name.startsWith("data-astro-cid-")) {
          el.setAttribute(atributo.name, atributo.value)
        }
      }
    }

    const pintarLista = (lista: Element | null, items: string[]) => {
      if (!lista) return
      const contenedor = lista
      contenedor.replaceChildren(
        ...items.map((texto) => {
          const li = document.createElement("li")
          const marca = document.createElement("span")
          marca.className = "ficha-hud__learn-arrow"
          marca.setAttribute("aria-hidden", "true")
          marca.textContent = "▸"
          const span = document.createElement("span")
          span.textContent = texto
          li.append(marca, span)
          heredarScope(li, contenedor)
          heredarScope(marca, contenedor)
          heredarScope(span, contenedor)
          return li
        }),
      )
    }

    const pintarReqsHud = (container: Element | null, items: string[]) => {
      if (!container) return
      const contenedor = container
      contenedor.replaceChildren(
        ...items.map((texto) => {
          const card = document.createElement("div")
          card.className = "ficha-hud__req-item"
          const dot = document.createElement("span")
          dot.className = "status-dot status-dot--cyan"
          dot.setAttribute("aria-hidden", "true")
          const text = document.createElement("span")
          text.className = "ficha-hud__req-text"
          text.textContent = texto
          card.append(dot, text)
          heredarScope(card, contenedor)
          heredarScope(dot, contenedor)
          heredarScope(text, contenedor)
          return card
        }),
      )
    }

    initCourseConfig((state) => {
      // Ficha adaptable: «Qué necesitas», «Qué vas a saber» y «Formato» se
      // repintan con la config y el total de la ruta activa (T8c).
      const ficha = document.querySelector<HTMLElement>("[data-ficha-adaptable]")
      if (ficha) {
        const copy = fichaDeRuta(state.config)
        pintarReqsHud(ficha.querySelector("[data-ficha-necesitas-hud]"), copy.necesitas)
        pintarLista(ficha.querySelector("[data-ficha-sabes]"), copy.sabes)
        const formato = ficha.querySelector<HTMLElement>("[data-ficha-formato]")
        const totalCurso = Number(ficha.getAttribute("data-ficha-total") || 0)
        if (formato) formato.textContent = formatoDeRuta(state.visibles.length, totalCurso)

        const badge = ficha.querySelector<HTMLElement>("[data-ficha-route-badge]")
        if (badge) {
          const env = state.config.entorno === "vm" ? "VM" : "HARDWARE"
          const boot =
            state.config.entorno === "vm"
              ? "SOLO LINUX"
              : state.config.arranque === "dualboot"
                ? "DUAL BOOT"
                : "SOLO LINUX"
          badge.textContent = `${env} · ${boot}`
        }

        const warnBox = ficha.querySelector<HTMLElement>("[data-ficha-warning]")
        if (warnBox) {
          const titleEl = warnBox.querySelector<HTMLElement>("[data-ficha-warning-title]")
          const descEl = warnBox.querySelector<HTMLElement>("[data-ficha-warning-desc]")
          const iconEl = warnBox.querySelector<HTMLElement>("[data-ficha-warning-icon]")

          warnBox.classList.remove(
            "ficha-hud__warning--danger",
            "ficha-hud__warning--warn",
            "ficha-hud__warning--safe",
          )

          if (state.config.entorno === "vm") {
            warnBox.classList.add("ficha-hud__warning--safe")
            if (iconEl) iconEl.textContent = "●"
            if (titleEl) titleEl.textContent = "ENTORNO SEGURO Y CONTROLADO"
            if (descEl)
              descEl.textContent =
                "No requiere formatear pendrive ni tocar tu PC; todo ocurre dentro del disco virtual."
          } else if (state.config.arranque === "dualboot") {
            warnBox.classList.add("ficha-hud__warning--warn")
            if (iconEl) iconEl.textContent = "▲"
            if (titleEl) titleEl.textContent = "DUAL BOOT CON WINDOWS"
            if (descEl)
              descEl.textContent =
                "Requiere Windows instalado en modo UEFI/GPT y tener tu clave de recuperación de BitLocker a mano."
          } else {
            warnBox.classList.add("ficha-hud__warning--danger")
            if (iconEl) iconEl.textContent = "▲"
            if (titleEl) titleEl.textContent = "¡HAZ UN RESPALDO!"
            if (descEl)
              descEl.textContent =
                "Esta ruta formateará el disco completo. Todo dato previo en el equipo será eliminado."
          }
        }
      }

      const key = progresoKey(state.slug)
      let done: string[] = []
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || "[]")
        if (Array.isArray(parsed)) done = parsed.filter((item) => typeof item === "string")
      } catch {}

      const isDone = (slug: string): boolean =>
        done.some((item) => item === slug || item.startsWith(`${slug}@`))

      // Aside de progreso: fila de la dificultad activa (denominador = ruta
      // activa). Se actualiza en cada cambio de config, sin recargar.
      const root = document.querySelector<HTMLElement>(`[data-progress-course="${state.slug}"]`)
      if (root) {
        const visibles = state.visibles
        const total = state.ruta
          ? visibles.length
          : Number(root.getAttribute("data-progress-total") || visibles.length)
        const n = visibles.filter(isDone).length
        const pct = total > 0 ? Math.min(100, Math.round((n / total) * 100)) : 0
        const unidad = root.getAttribute("data-unidad") || "lecciones"
        root.setAttribute("data-progress-total", String(total))
        const label = root.querySelector("[data-progress-label]")
        if (label) label.textContent = `${n} / ${total} ${unidad} (${pct}%)`
        const fill = root.querySelector<HTMLElement>("[data-progress-fill]")
        if (fill) fill.style.width = `${pct}%`
        const bar = root.querySelector('[role="progressbar"]')
        bar?.setAttribute("aria-valuenow", String(n))
        bar?.setAttribute("aria-valuemax", String(total))
      }

      const barRoot = document.querySelector(`[data-bar-progress-course="${state.slug}"]`)
      if (barRoot) {
        const barVisibles = state.visibles
        const barTotal = Number(
          barRoot.getAttribute("data-bar-progress-total") || barVisibles.length,
        )
        const barUnidad = barRoot.getAttribute("data-bar-unidad") || "lecciones"
        const barDone = Math.min(barVisibles.filter(isDone).length, barTotal)
        const barPct = barTotal > 0 ? Math.round((barDone / barTotal) * 100) : 0
        const barLabel = barRoot.querySelector("[data-bar-progress-label]")
        if (barLabel) barLabel.textContent = `${barDone} / ${barTotal} ${barUnidad}`
        const barFill = barRoot.querySelector<HTMLElement>("[data-bar-progress-fill]")
        if (barFill) barFill.style.width = `${barPct}%`
        const barTrack = barRoot.querySelector('[role="progressbar"]')
        barTrack?.setAttribute("aria-valuenow", String(barDone))
        barTrack?.setAttribute("aria-valuemax", String(barTotal))
      }

      const cta = document.getElementById("cta-continue")
      if (!cta) return

      const base = cta.getAttribute("data-base") || ""
      const etiqueta = cta.getAttribute("data-unidad") || "clase"
      const visibles = state.visibles
      cta.setAttribute("data-lessons", JSON.stringify(visibles))

      const ctaLabel = cta.querySelector("span:first-child")
      const siguiente = visibles.find((slug) => !isDone(slug))
      const marcadas = visibles.filter(isDone).length
      const etiquetaInicio = etiqueta === "nivel" ? "Empezar por el nivel 0" : "Empezar la clase 1"
      if (siguiente) {
        const idx = visibles.indexOf(siguiente)
        cta.setAttribute("href", `${base}${siguiente}/`)
        if (ctaLabel) {
          ctaLabel.textContent =
            marcadas === 0 ? etiquetaInicio : `Continuar · ${etiqueta} ${idx + 1}`
        }
      } else if (visibles.length) {
        cta.setAttribute("href", `${base}${visibles[0]}/`)
        if (ctaLabel) ctaLabel.textContent = "Curso completado · Repasar desde el inicio"
      }
    })
  </script>

  <script is:inline define:vars={{ slug: info.slug, total: totalDefecto, unidad, progresoBase }}>
    try {
      // Config de la fila activa: la query manda sobre storage (aunque la clave
      // de progreso ya no dependa de la dificultad).
      const sanitize = (value) => (value === "avanzada" ? "avanzada" : "facil")
      const params = new URLSearchParams(window.location.search)
      const fromQuery = params.get("dificultad")
      const dificultad =
        fromQuery !== null
          ? sanitize(fromQuery)
          : sanitize(localStorage.getItem(`ncw:difficulty:${slug}`))

      const key = progresoBase
      const parsed = JSON.parse(localStorage.getItem(key) || "[]")
      const marks = Array.isArray(parsed) ? parsed.filter((item) => typeof item === "string") : []
      const isDone = (lesson) =>
        marks.some((mark) => mark === lesson || mark.startsWith(`${lesson}@`))

      const cta = document.getElementById("cta-continue")
      const lessons = cta ? JSON.parse(cta.getAttribute("data-lessons") || "[]") : []
      const n = lessons.filter(isDone).length
      const pct = total > 0 ? Math.min(100, Math.round((n / total) * 100)) : 0

      const root = document.querySelector(`[data-progress-course="${slug}"]`)
      if (root) {
        root.setAttribute("data-dificultad", dificultad)
        root.querySelector("[data-progress-label]").textContent =
          `${n} / ${total} ${unidad} (${pct}%)`
        root.querySelector("[data-progress-fill]").style.width = `${pct}%`
        root.querySelector('[role="progressbar"]')?.setAttribute("aria-valuenow", String(n))
      }

      const barRoot = document.querySelector(`[data-bar-progress-course="${slug}"]`)
      if (barRoot) {
        const barTotal = Number(barRoot.getAttribute("data-bar-progress-total") || total)
        const barUnidad = barRoot.getAttribute("data-bar-unidad") || "lecciones"
        const barDone = Math.min(n, barTotal)
        const barPct = barTotal > 0 ? Math.round((barDone / barTotal) * 100) : 0
        const barLabel = barRoot.querySelector("[data-bar-progress-label]")
        if (barLabel) barLabel.textContent = `${barDone} / ${barTotal} ${barUnidad}`
        const barFill = barRoot.querySelector("[data-bar-progress-fill]")
        if (barFill) barFill.style.width = `${barPct}%`
        const barTrack = barRoot.querySelector('[role="progressbar"]')
        barTrack?.setAttribute("aria-valuenow", String(barDone))
        barTrack?.setAttribute("aria-valuemax", String(barTotal))
      }

      if (cta) {
        const baseHref = cta.getAttribute("data-base") || ""
        const etiqueta = cta.getAttribute("data-unidad") || "clase"
        const nextSlug = lessons.find((lesson) => !isDone(lesson))
        if (nextSlug) {
          const nextIndex = lessons.indexOf(nextSlug)
          cta.setAttribute("href", `${baseHref}${nextSlug}/`)
          cta.querySelector("span:first-child").textContent =
            n === 0
              ? etiqueta === "nivel"
                ? "Empezar por el nivel 0"
                : "Empezar la clase 1"
              : `Continuar · ${etiqueta} ${nextIndex}`
        } else {
          cta.querySelector("span:first-child").textContent =
            "Curso completado · Repasar desde el inicio"
        }
      }

      for (const item of document.querySelectorAll("[data-lesson-item]")) {
        const lesson = item.getAttribute("data-lesson-item")
        item.classList.toggle("is-done", Boolean(lesson) && isDone(lesson))
      }
      for (const mod of document.querySelectorAll("[data-module-key]")) {
        const items = [...mod.querySelectorAll("[data-lesson-item]")]
        const doneCount = items.filter((item) => {
          const lesson = item.getAttribute("data-lesson-item")
          return Boolean(lesson) && isDone(lesson)
        }).length
        const doneEl = mod.querySelector("[data-module-done]")
        const fillEl = mod.querySelector("[data-module-fill]")
        if (doneEl) doneEl.textContent = `${doneCount}/${items.length}`
        if (fillEl) {
          fillEl.style.width = items.length
            ? `${Math.round((doneCount / items.length) * 100)}%`
            : "0%"
        }
      }
    } catch {}
  </script>
</BaseLayout>


---
import { getCollection } from "astro:content"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import CourseModuleList from "../../../components/CourseModuleList.astro"
import { site } from "../../../data/site"
import { getCurso, cursos } from "../../../data/cursos"
import { getCategoria } from "../../../data/categorias"
import {
  groupSyllabus,
  normalizeLesson,
  totalSyllabusMin,
  formatTotalMin,
} from "../../../lib/syllabus"

export async function getStaticPaths() {
  return cursos.map((c) => ({ params: { slug: c.slug } }))
}

const { slug } = Astro.params
const info = getCurso(slug!)
if (!info) throw new Error(`Curso no definido en src/data/cursos.ts: ${slug}`)
const categoria = getCategoria(info.categoria)

const lecciones = (
  await getCollection("cursos", ({ data }) => !data.draft && data.curso === slug)
).sort((a, b) => a.data.orden - b.data.orden)
const modules = groupSyllabus(lecciones.map((l) => normalizeLesson(l.id, l.data)))
const totalVideoMin = totalSyllabusMin(modules)
const videosPublicados = lecciones.filter((l) => Boolean(l.data.video)).length
const totalCapitulos = modules.reduce(
  (acc, m) => acc + m.lecciones.reduce((n, l) => n + l.capitulos.length, 0),
  0,
)

const base = site.base
const firstLessonSlug = lecciones[0]?.id.split("/").pop()
const lessonSlugs = lecciones.map((l) => l.id.split("/").pop()!)
const totalLessons = lecciones.length
---

<BaseLayout titulo={info.titulo} descripcion={info.descripcion}>
  <section class="course-hero">
    <div class="container-page">
      <nav class="breadcrumb" aria-label="Miga de pan">
        <a href={`${base}cursos/`}>Cursos</a>
        <span aria-hidden="true">/</span>
        {categoria && (
          <>
            <a href={`${base}cursos/#${categoria.id}`}>{categoria.titulo}</a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span aria-current="page">{info.titulo}</span>
      </nav>

      <div class="course-hero__grid">
        <div class="course-hero__main">
          <div class="course-hero__docket">
            <span class="docket">
              Expediente de curso · <strong>01</strong>
            </span>
            <span class="chip chip--signal">
              <span class="status-dot" aria-hidden="true"></span>
              {videosPublicados > 0 ? "Curso publicado" : "Guía publicada"}
            </span>
          </div>

          <h1 class="course-hero__title">{info.titulo}</h1>
          <p class="lead course-hero__promise">{info.promesa}</p>

          <div class="course-hero__meta">
            <span>{info.nivel}</span>
            <span>{totalLessons} lecciones</span>
            <span>{modules.length} módulos</span>
            {videosPublicados > 0 ? (
              <span>
                {videosPublicados} de {totalLessons} videos
                {totalVideoMin > 0 && <> · ~{formatTotalMin(totalVideoMin)}</>}
              </span>
            ) : (
              <span>Guía escrita · video en preparación</span>
            )}
          </div>

          <div
            class="mission-meter sheet sheet--flat"
            data-progress-course={slug}
            data-progress-total={totalLessons}
          >
            <div class="mission-meter__head">
              <span class="status">
                <span class="status-dot" aria-hidden="true"></span>
                Tu avance en el curso
              </span>
              <strong data-progress-label>0 / {totalLessons} clases</strong>
            </div>
            <div class="progress-track" role="progressbar" aria-label="Progreso del curso">
              <div class="progress-fill" data-progress-fill></div>
            </div>
            <p class="mission-meter__note">Guardado solo en este navegador. Sin cuentas.</p>
          </div>

          <div class="course-hero__actions">
            {firstLessonSlug && (
              <a
                href={`${base}cursos/${slug}/${firstLessonSlug}/`}
                id="cta-continue"
                class="btn btn-primary btn-lg"
                data-lessons={JSON.stringify(lessonSlugs)}
                data-base={`${base}cursos/${slug}/`}
              >
                <span>Empezar desde la Clase 1</span>
                <span aria-hidden="true">→</span>
              </a>
            )}
            <a href="#temario" class="btn btn-secondary btn-lg">
              <span>Ver temario</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <aside class="course-aside sheet sheet--cut" aria-labelledby="course-aside-title">
          <span class="tape course-aside__tape" aria-hidden="true"></span>
          <h2 id="course-aside-title" class="course-aside__title">
            Ficha del taller
          </h2>

          <div class="course-aside__block">
            <p class="course-aside__label">Equipo requerido</p>
            <ul class="course-aside__req">
              {info.requisitos.map((r) => (
                <li>
                  <span aria-hidden="true">▹</span>
                  {r}
                </li>
              ))}
            </ul>
          </div>

          <div class="course-aside__block">
            <p class="course-aside__label">Formato</p>
            <p class="course-aside__text">
              {totalLessons} lecciones en {modules.length} módulos con guía escrita, comandos
              copiables para terminal, advertencias de seguridad y ejercicios prácticos.
              {videosPublicados > 0 ? (
                <> Incluye {videosPublicados} videos disponibles.</>
              ) : (
                <> Los videos están en preparación.</>
              )}
              {totalCapitulos > 0 && <> Incluye {totalCapitulos} capítulos con timestamp.</>}
            </p>
          </div>

          <div class="course-aside__block course-aside__block--last">
            <p class="course-aside__label">Regla de campo</p>
            <p class="course-aside__text">
              Practica en una máquina virtual o en hardware propio. Nada de ataques a sistemas
              ajenos.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="course-syllabus" id="temario">
    <div class="container-page">
      <div class="course-syllabus__head">
        <div>
          <p class="label-rule">Temario del curso</p>
          <h2 class="course-syllabus__title">Curso → módulo → submódulo → lección.</h2>
        </div>
        <span class="meta">
          {modules.length} módulos · {totalLessons} clases
          {videosPublicados > 0
            ? ` · ${videosPublicados} de ${totalLessons} videos`
            : " · guía escrita"}
        </span>
      </div>

      <CourseModuleList modules={modules} slug={slug!} base={base} variant="page" />
    </div>
  </section>

  <script is:inline define:vars={{ slug, total: totalLessons }}>
    // Read local progress and reflect it in the CTA, meter and module rows.
    try {
      const done = JSON.parse(localStorage.getItem(`ncw:progress:${slug}`) || "[]")
      const key = Array.isArray(done) ? done : []
      const n = key.length
      const pct = Math.round((n / total) * 100)

      const root = document.querySelector(`[data-progress-course="${slug}"]`)
      if (root) {
        root.querySelector("[data-progress-label]").textContent = `${n} / ${total} clases (${pct}%)`
        root.querySelector("[data-progress-fill]").style.width = `${pct}%`
        root.querySelector('[role="progressbar"]')?.setAttribute("aria-valuenow", String(n))
      }

      const cta = document.getElementById("cta-continue")
      if (cta) {
        const lessons = JSON.parse(cta.getAttribute("data-lessons") || "[]")
        const baseHref = cta.getAttribute("data-base") || ""
        const nextSlug = lessons.find((l) => !key.includes(l))
        if (nextSlug) {
          const nextIndex = lessons.indexOf(nextSlug) + 1
          cta.setAttribute("href", `${baseHref}${nextSlug}/`)
          cta.querySelector("span:first-child").textContent =
            n === 0
              ? "Empezar desde la Clase 1"
              : `Continuar · Clase ${nextIndex} de ${lessons.length}`
        } else {
          cta.querySelector("span:first-child").textContent =
            "Curso completado · Repasar desde la Clase 1"
        }
      }

      for (const item of document.querySelectorAll("[data-lesson-item]")) {
        item.classList.toggle("is-done", key.includes(item.getAttribute("data-lesson-item")))
      }
      for (const mod of document.querySelectorAll("[data-module-key]")) {
        const items = [...mod.querySelectorAll("[data-lesson-item]")]
        const doneCount = items.filter((i) =>
          key.includes(i.getAttribute("data-lesson-item")),
        ).length
        const doneEl = mod.querySelector("[data-module-done]")
        const fillEl = mod.querySelector("[data-module-fill]")
        if (doneEl) doneEl.textContent = `${doneCount}/${items.length}`
        if (fillEl)
          fillEl.style.width = items.length
            ? `${Math.round((doneCount / items.length) * 100)}%`
            : "0%"
      }
    } catch {}
  </script>
</BaseLayout>

<style>
  .course-hero {
    position: relative;
    padding-block: clamp(1.25rem, 3vw, 2.25rem) clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .course-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 1px 1px, var(--line) 0.7px, transparent 0.8px),
      linear-gradient(
        90deg,
        transparent 0 71%,
        color-mix(in srgb, var(--accent) 14%, transparent) 71% 71.15%,
        transparent 71.15% 100%
      );
    background-size:
      22px 22px,
      100% 100%;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
    opacity: 0.55;
  }

  .course-hero .container-page {
    position: relative;
    z-index: 1;
  }

  .course-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: 1.5rem;
  }

  .course-hero__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .course-hero__title {
    margin-top: 0.9rem;
    max-width: 20ch;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .course-hero__promise {
    margin-top: 1rem;
    max-width: 54ch;
  }

  .course-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .mission-meter {
    max-width: 34rem;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
  }

  .mission-meter__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-dim);
  }

  .mission-meter__head strong {
    color: var(--signal);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .mission-meter__note {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-muted);
  }

  .course-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .course-aside {
    --sheet-cut: 26px;
    position: relative;
    padding: 1.35rem;
    background: var(--bg-raised);
  }

  .course-aside__tape {
    top: -0.55rem;
    right: 1.75rem;
    width: 4.5rem;
    transform: rotate(4deg);
  }

  .course-aside__title {
    font-size: 1.2rem;
    letter-spacing: -0.025em;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .course-aside__block {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .course-aside__block--last {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .course-aside__label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .course-aside__req {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .course-aside__req li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--ink-dim);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .course-aside__req li span {
    color: var(--signal);
  }

  .course-aside__text {
    margin-top: 0.45rem;
    color: var(--ink-dim);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .course-syllabus {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .course-syllabus__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .course-syllabus__title {
    margin-top: 0.6rem;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.03em;
  }

  @media (max-width: 900px) {
    .course-hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .course-aside {
      max-width: 34rem;
    }
  }
</style>

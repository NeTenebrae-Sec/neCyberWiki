---
import BaseLayout from "../layouts/BaseLayout.astro"
import { site } from "../data/site"

const base = site.base
---

<BaseLayout
  titulo="Buscar"
  descripcion="Búsqueda estática en neCyberWiki: cursos, lecciones, bitácora y roadmap."
  noindex
  buscadorHeader={false}
>
  <section class="buscar container-page">
    <div class="buscar__docket">
      <span class="docket">Buscador</span>
      <span class="chip">Página estática</span>
    </div>

    <h1 class="display buscar__title">Buscar en neCyberWiki.</h1>
    <p class="lead buscar__lead">
      Busca en lo que ya está publicado: cursos, lecciones, bitácora y roadmap. Sin backend, sin
      rastreo.
    </p>

    <pagefind-config instance="page" bundle-path={`${base}pagefind/`}></pagefind-config>

    <div class="buscar__ui">
      <pagefind-input
        instance="page"
        placeholder="Buscar en cursos, notas y roadmap…"
      ></pagefind-input>
      <pagefind-summary
        instance="page"
        default-message="Escribe para buscar en cursos, lecciones y bitácora."
      ></pagefind-summary>
      <pagefind-results instance="page" hide-sub-results max-results="10"></pagefind-results>
      <pagefind-keyboard-hints instance="page"></pagefind-keyboard-hints>
    </div>

    <p class="buscar__hint">
      El buscador indexa el build completo: cursos, lecciones, bitácora y roadmap.
    </p>
  </section>

  <script is:inline>
    customElements.whenDefined("pagefind-input").then(() => {
      const input = document.querySelector('pagefind-input[instance="page"] input')
      if (!input) return
      const focus = () => {
        if (document.querySelector("dialog[open]")) return
        input.focus({ preventScroll: true })
      }
      const query = new URLSearchParams(location.search).get("q")
      if (query) {
        input.value = query
        input.dispatchEvent(new Event("input", { bubbles: true }))
      }
      focus()
      window.addEventListener("ncw:legal-accepted", focus)
    })
  </script>

  <style>
    .buscar {
      max-width: 860px;
      padding-block: clamp(2.5rem, 6vw, 5rem) 0;
    }

    .buscar__docket {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
      margin-bottom: 1rem;
    }

    .buscar__title {
      font-size: clamp(2.4rem, 5.5vw, 4.5rem);
      line-height: 0.95;
    }

    .buscar__lead {
      margin-top: 1.1rem;
    }

    .buscar__ui {
      margin-top: 2rem;
    }

    .buscar__ui pagefind-input {
      --pf-input-height: 48px;
      --pf-input-font-size: 16px;
    }

    .buscar__hint {
      margin-top: 1rem;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.03em;
      color: var(--ink-muted);
    }
  </style>
</BaseLayout>

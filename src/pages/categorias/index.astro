---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { site } from "../../data/site"
import { CATEGORIAS } from "../../data/categorias"

const base = site.base
const activasCount = CATEGORIAS.filter((c) => c.estado === "activo").length
const prepCount = CATEGORIAS.filter((c) => c.estado === "en-preparacion").length
---

<BaseLayout
  titulo="Mapa de sectores · Especialización técnica"
  descripcion="Explora los 8 módulos de aprendizaje de neCyberWiki: Fundamentos, Sistemas Linux, Pentesting Web, CTFs, Programación, IA, Herramientas y Privacidad."
>
  <section class="map-hero">
    <div class="container-page">
      <div class="map-hero__docket">
        <span class="docket">Taxonomía de conocimiento</span>
        <span class="chip">8 módulos canónicos</span>
      </div>

      <div class="map-hero__grid">
        <div>
          <h1 class="display map-hero__title">Mapa de sectores.</h1>
          <p class="lead map-hero__lead">
            Ocho módulos, una secuencia recomendada. Cada sector reúne las guías, cursos y
            laboratorios disponibles. Empieza por donde estés y sigue el cable.
          </p>
        </div>

        <dl class="map-facts">
          <div>
            <dt>Total</dt>
            <dd>
              {CATEGORIAS.length}
              <span> sectores</span>
            </dd>
          </div>
          <div>
            <dt>Activos</dt>
            <dd class="signal">
              {activasCount}
              <span> con material</span>
            </dd>
          </div>
          <div>
            <dt>En preparación</dt>
            <dd class="stamp-color">
              {prepCount}
              <span> sellados</span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="map-body">
    <div class="container-page">
      <div class="filter-bar">
        <div class="field filter-bar__search">
          <label for="category-search">Buscar tecnología</label>
          <div class="filter-bar__input">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="category-search"
              class="input"
              placeholder="linux, ssrf, ctf, python…"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="category-count"
            />
          </div>
        </div>

        <div class="filter-bar__tabs" id="filter-tabs" role="group" aria-label="Filtrar por estado">
          <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
            Todos <span>{CATEGORIAS.length}</span>
          </button>
          <button type="button" class="filter-btn" data-filter="activo" aria-pressed="false">
            Disponibles <span>{activasCount}</span>
          </button>
          <button
            type="button"
            class="filter-btn"
            data-filter="en-preparacion"
            aria-pressed="false"
          >
            Próximamente <span>{prepCount}</span>
          </button>
        </div>

        <p id="category-count" class="filter-bar__count" role="status" aria-live="polite">
          {CATEGORIAS.length} sectores visibles
        </p>
      </div>

      <div class="sector-list" id="categories-container">
        {CATEGORIAS.map((cat) => {
          const isActivo = cat.estado === "activo"
          return (
            <article
              id={cat.id}
              class="sector sheet sheet--cut"
              data-estado={cat.estado}
              data-keywords={`${cat.titulo} ${cat.tagline} ${cat.descripcion} ${cat.tags.join(" ")}`.toLowerCase()}
            >
              <span
                class:list={["sector__spine", isActivo ? "is-active" : "is-pending"]}
                aria-hidden="true"
              ></span>

              <div class="sector__inner">
                <header class="sector__head">
                  <div>
                    <p class="sector__docket">
                      <span class="accent">Módulo {cat.indice}</span>
                      <span aria-hidden="true">·</span>
                      <span>{cat.nivel}</span>
                    </p>
                    <h2 class="sector__title">{cat.titulo}</h2>
                    <p class="sector__tagline">{cat.tagline}</p>
                  </div>

                  <span class:list={["chip", isActivo ? "chip--signal" : "chip--warn"]}>
                    <span
                      class:list={["status-dot", isActivo ? "" : "status-dot--amber"]}
                      aria-hidden="true"
                    />
                    {cat.badgeTexto}
                  </span>
                </header>

                <div class="sector__grid">
                  <div class="sector__desc">
                    <h3 class="sector__label">Objetivo del módulo</h3>
                    <p>{cat.descripcion}</p>

                    <h3 class="sector__label sector__label--spaced">Temas clave</h3>
                    <ul class="tags" aria-label="Temas clave">
                      {cat.tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                    </ul>
                  </div>

                  <div class="sector__resources">
                    <div class="sector__resources-head">
                      <h3 class="sector__label">Guías, cursos y laboratorios</h3>
                      <span class="meta">{cat.recursos.length} entradas</span>
                    </div>

                    <ul>
                      {cat.recursos.map((rec) => {
                        const hasLink = Boolean(rec.enlace)
                        return (
                          <li class="sector-resource">
                            <span class="sector-resource__type">{rec.tipo}</span>
                            <span class="sector-resource__main">
                              <span class="sector-resource__title">{rec.titulo}</span>
                              {rec.detalle && (
                                <span class="sector-resource__detail">{rec.detalle}</span>
                              )}
                            </span>
                            <span class="sector-resource__action">
                              {hasLink ? (
                                <a href={`${base}${rec.enlace}`}>
                                  Acceder <span aria-hidden="true">→</span>
                                </a>
                              ) : rec.estado === "disponible" ? (
                                <span class="signal">En el archivo</span>
                              ) : (
                                <span class="muted">Próximamente</span>
                              )}
                            </span>
                          </li>
                        )
                      })}
                    </ul>
                  </div>
                </div>
              </div>
            </article>
          )
        })}
      </div>

      <div id="no-results" class="empty" hidden>
        <h2>No se encontraron sectores</h2>
        <p>Prueba con otros términos como «linux», «web», «redes» o «ctf».</p>
        <button type="button" class="btn btn-secondary" id="reset-filters">
          Limpiar filtros
        </button>
      </div>
    </div>
  </section>

  <script is:inline>
    const searchInput = document.getElementById("category-search")
    const filterTabs = [...document.querySelectorAll(".filter-btn")]
    const cards = [...document.querySelectorAll(".sector")]
    const noResults = document.getElementById("no-results")
    const countLabel = document.getElementById("category-count")
    const resetButton = document.getElementById("reset-filters")

    let currentFilter = "all"
    let searchQuery = ""

    const updateCards = () => {
      let visibleCount = 0

      cards.forEach((card) => {
        const estado = card.getAttribute("data-estado")
        const keywords = card.getAttribute("data-keywords") || ""
        const matchesFilter = currentFilter === "all" || estado === currentFilter
        const matchesSearch = !searchQuery || keywords.includes(searchQuery)
        const visible = matchesFilter && matchesSearch

        card.hidden = !visible
        if (visible) visibleCount++
      })

      if (noResults) noResults.hidden = visibleCount > 0
      if (countLabel) {
        countLabel.textContent = `${visibleCount} ${
          visibleCount === 1 ? "sector visible" : "sectores visibles"
        }`
      }
    }

    const setFilter = (filter) => {
      currentFilter = filter
      filterTabs.forEach((tab) => {
        tab.setAttribute("aria-pressed", String(tab.getAttribute("data-filter") === filter))
      })
      updateCards()
    }

    searchInput?.addEventListener("input", (event) => {
      searchQuery = event.target.value.toLowerCase().trim()
      updateCards()
    })

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => setFilter(tab.getAttribute("data-filter") || "all"))
    })

    resetButton?.addEventListener("click", () => {
      if (searchInput instanceof HTMLInputElement) searchInput.value = ""
      searchQuery = ""
      setFilter("all")
      searchInput?.focus()
    })
  </script>
</BaseLayout>

<style>
  .map-hero {
    position: relative;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .map-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle at 1px 1px, var(--line) 0.7px, transparent 0.8px),
      linear-gradient(
        0deg,
        transparent 0 63%,
        color-mix(in srgb, var(--accent) 14%, transparent) 63% 63.15%,
        transparent 63.15% 100%
      );
    background-size:
      22px 22px,
      100% 100%;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
    opacity: 0.6;
  }

  .map-hero .container-page {
    position: relative;
    z-index: 1;
  }

  .map-hero__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.2rem;
  }

  .map-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: end;
  }

  .map-hero__title {
    font-size: clamp(2.4rem, 5.5vw, 4.75rem);
    line-height: 0.94;
  }

  .map-hero__lead {
    margin-top: 1.2rem;
    max-width: 56ch;
  }

  .map-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .map-facts > div {
    padding: 0.8rem 0.7rem;
  }

  .map-facts > div + div {
    border-left: 1px solid var(--line);
  }

  .map-facts dt {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .map-facts dd {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .map-facts dd span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-muted);
  }

  .map-body {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  }

  .filter-bar {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto;
    gap: 1rem 1.5rem;
    align-items: end;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
  }

  .filter-bar__input {
    position: relative;
  }

  .filter-bar__input svg {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-muted);
    pointer-events: none;
  }

  .filter-bar__input .input {
    padding-left: 2.2rem;
  }

  .filter-bar__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      border-color var(--dur-ui) var(--ease-out),
      background-color var(--dur-ui) var(--ease-out),
      color var(--dur-ui) var(--ease-out);
  }

  .filter-btn span {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .filter-btn[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .filter-btn[aria-pressed="true"] span {
    color: var(--accent-ink);
    opacity: 0.7;
  }

  .filter-btn:hover:not([aria-pressed="true"]) {
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .filter-bar__count {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-muted);
    border-top: 1px solid var(--line);
    padding-top: 0.7rem;
  }

  .sector-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .sector {
    --sheet-cut: 28px;
    position: relative;
    padding-left: 0.45rem;
    overflow: hidden;
  }

  .sector__spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.45rem;
  }

  .sector__spine.is-active {
    background: repeating-linear-gradient(0deg, var(--accent) 0 20px, transparent 20px 26px);
    opacity: 0.6;
  }

  .sector__spine.is-pending {
    background: repeating-linear-gradient(0deg, var(--line-strong) 0 20px, transparent 20px 26px);
  }

  .sector__inner {
    padding: clamp(1.15rem, 2.6vw, 1.9rem);
  }

  .sector__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.9rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .sector__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .sector__title {
    margin-top: 0.35rem;
    font-size: clamp(1.6rem, 2.8vw, 2.15rem);
    letter-spacing: -0.03em;
  }

  .sector__tagline {
    margin-top: 0.3rem;
    max-width: 62ch;
    color: var(--ink-dim);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .sector__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-top: 1.1rem;
  }

  .sector__label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .sector__label--spaced {
    margin-top: 1.15rem;
  }

  .sector__desc p {
    margin-top: 0.55rem;
    color: var(--ink-dim);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .sector__desc .tags {
    margin-top: 0.6rem;
  }

  .sector__resources {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-sunken);
    padding: 0 0.85rem 0.35rem;
  }

  .sector__resources-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .sector-resource {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .sector-resource:last-child {
    border-bottom: 0;
  }

  .sector-resource__type {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sector-resource__title {
    display: block;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .sector-resource__detail {
    display: block;
    margin-top: 0.12rem;
    color: var(--ink-dim);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .sector-resource__action {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    white-space: nowrap;
  }

  .sector-resource__action a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  @media (max-width: 900px) {
    .map-hero__grid,
    .sector__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .filter-bar {
      grid-template-columns: minmax(0, 1fr);
    }

    .sector__resources {
      padding-inline: 0.7rem;
    }
  }

  @media (max-width: 640px) {
    .map-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .map-facts > div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }

    .map-facts > div + div {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .map-facts dd span {
      display: inline;
      margin-left: 0.4rem;
    }

    .sector-resource {
      grid-template-columns: 3.4rem minmax(0, 1fr);
      gap: 0.35rem 0.6rem;
    }

    .sector-resource__action {
      grid-column: 2;
    }
  }
</style>

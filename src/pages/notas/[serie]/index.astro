---
import { getCollection } from "astro:content"
import BaseLayout from "../../../layouts/BaseLayout.astro"
import { site } from "../../../data/site"
import { SERIES, getSerie } from "../../../data/series"
import { getCategoria } from "../../../data/categorias"

export async function getStaticPaths() {
  const notas = await getCollection("notas", ({ data }) => !data.draft)
  const publicadas = new Set(notas.map((nota) => nota.data.serie))
  return SERIES.filter((serie) => publicadas.has(serie.slug)).map((serie) => ({
    params: { serie: serie.slug },
  }))
}

const { serie: slug } = Astro.params
const serie = getSerie(slug!)
if (!serie) throw new Error(`Serie no definida en src/data/series.ts: ${slug}`)

const categoria = getCategoria(serie.categoria)
const notas = (
  await getCollection("notas", ({ data }) => !data.draft && data.serie === slug)
).sort((a, b) => a.data.orden - b.data.orden)
const base = site.base
const serieUrl = `${base}notas/${serie.slug}/`
const primera = notas[0]
const fmt = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", { year: "numeric", month: "long", day: "numeric" }).format(date)
const h1 = `${serie.titulo}: ${notas.length} niveles documentados`
---

<BaseLayout titulo={h1} descripcion={serie.descripcion}>
  <section class="series-hero">
    <div class="container-page">
      <nav class="breadcrumb" aria-label="Miga de pan">
        <a href={`${base}notas/`}>Notas</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{serie.titulo}</span>
      </nav>

      <div class="series-hero__docket">
        <span class="docket">Serie de notas</span>
        <a class="chip chip--blog" href={serie.url} target="_blank" rel="noopener">
          {serie.plataforma} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="series-hero__grid">
        <div>
          <h1 class="display series-hero__title">{serie.titulo}</h1>
          <p class="lead series-hero__lead">{serie.descripcion}</p>

          <div class="series-hero__actions">
            {primera && (
              <a class="btn btn-primary btn-lg" href={`${serieUrl}${primera.data.orden}/`}>
                Empezar por el nivel {primera.data.orden} <span aria-hidden="true">→</span>
              </a>
            )}
            <a class="btn btn-secondary btn-lg" href={serie.url} target="_blank" rel="noopener">
              Ir a {serie.plataforma} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <dl class="series-facts">
          <div>
            <dt>Niveles</dt>
            <dd>{String(notas.length).padStart(2, "0")}</dd>
          </div>
          <div>
            <dt>Nivel</dt>
            <dd>{serie.nivel}</dd>
          </div>
          <div>
            <dt>Categoría</dt>
            <dd>
              {categoria ? (
                <a href={`${base}cursos/#${categoria.id}`}>{categoria.titulo}</a>
              ) : (
                serie.categoria
              )}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="series-body">
    <div class="container-page series-layout">
      <div class="series-main">
        <div class="series-list__head">
          <p class="label-rule">Índice de niveles</p>
          <span class="meta">De {notas[0]?.data.orden ?? 0} a {notas.at(-1)?.data.orden ?? 0}</span>
        </div>

        <ol class="series-levels">
          {notas.map((nota) => {
            const nivel = nota.id.split("/").pop()
            return (
              <li>
                <a class="level-row" href={`${serieUrl}${nivel}/`}>
                  <span class="level-row__num">{String(nota.data.orden).padStart(2, "0")}</span>
                  <span class="level-row__main">
                    <span class="level-row__title">{nota.data.title}</span>
                    <span class="level-row__desc">{nota.data.description}</span>
                    {nota.data.tags.length > 0 && (
                      <span class="level-row__tags">
                        {nota.data.tags.slice(0, 4).map((tag) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </span>
                    )}
                  </span>
                  <time class="level-row__date" datetime={nota.data.date.toISOString()}>
                    {fmt(nota.data.date)}
                  </time>
                  <span class="level-row__arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            )
          })}
        </ol>
      </div>

      <aside class="series-aside" aria-labelledby="serie-aviso">
        <div class="series-aside__sheet sheet sheet--flat">
          <p class="docket">Antes de empezar</p>
          <h2 class="series-aside__title" id="serie-aviso">Un laboratorio, no un objetivo.</h2>
          <p class="series-aside__text">
            {serie.plataforma} es un entorno legal y controlado para practicar. Las notas documentan
            el recorrido, pero el aprendizaje real está en repetir los comandos y entender por qué
            funcionan.
          </p>
          <ul class="series-aside__list">
            <li>Las contraseñas de los niveles están censuradas.</li>
            <li>No se documentan ataques fuera del laboratorio.</li>
            <li>Los niveles avanzan en dificultad: empieza por el 0.</li>
          </ul>
          <a class="arrow-link" href={serie.url} target="_blank" rel="noopener">
            Reglas oficiales{" "}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .series-hero {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .series-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle at 1px 1px, var(--line) 0.7px, transparent 0.8px);
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
    opacity: 0.5;
  }

  .series-hero .container-page {
    position: relative;
    z-index: 1;
  }

  .series-hero__docket {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
  }

  .series-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(250px, 0.7fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: end;
    margin-top: 1rem;
  }

  .series-hero__title {
    font-size: clamp(2.35rem, 5.5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .series-hero__lead {
    margin-top: 1.1rem;
    max-width: 58ch;
  }

  .series-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  .series-facts {
    display: grid;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .series-facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }

  .series-facts > div + div {
    border-top: 1px solid var(--line);
  }

  .series-facts dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .series-facts dd {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    text-align: right;
  }

  .series-facts a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .series-body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .series-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.38fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .series-main {
    min-width: 0;
  }

  .series-list__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .series-levels {
    margin-top: 0.75rem;
    border-top: 1px solid var(--line-strong);
    list-style: none;
    padding: 0;
  }

  .level-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto 1rem;
    gap: 0.85rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .level-row__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
  }

  .level-row__title {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.15;
  }

  .level-row__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.25rem;
    color: var(--ink-dim);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .level-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.45rem;
  }

  .level-row__tags .tag {
    font-size: 0.56rem;
    padding-block: 0.1rem;
  }

  .level-row__date {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .level-row__arrow {
    color: var(--accent);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .level-row:hover .level-row__title {
    color: var(--accent);
  }

  .level-row:hover .level-row__arrow {
    transform: translateX(3px);
  }

  .series-aside {
    position: sticky;
    top: 6rem;
  }

  .series-aside__sheet {
    padding: 1.1rem 1.15rem 1.2rem;
    border-left: 3px solid var(--blog);
  }

  .series-aside__title {
    margin-top: 0.55rem;
    font-size: 1.3rem;
    line-height: 1.1;
    letter-spacing: -0.028em;
  }

  .series-aside__text {
    margin-top: 0.7rem;
    color: var(--ink-dim);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .series-aside__list {
    display: grid;
    gap: 0.35rem;
    margin-block: 0.9rem;
    padding-left: 1.05rem;
    color: var(--ink-dim);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .series-aside__list li::marker {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .series-hero__grid,
    .series-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .series-aside {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 640px) {
    .level-row {
      grid-template-columns: 1.8rem minmax(0, 1fr) 1rem;
      gap: 0.35rem 0.6rem;
    }

    .level-row__date {
      grid-column: 2;
      grid-row: 2;
    }

    .level-row__arrow {
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .series-hero__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

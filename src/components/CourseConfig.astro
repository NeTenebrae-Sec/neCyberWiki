---
import { CONFIG_POR_DEFECTO } from "../lib/tracks"
import type { CursoPublicado } from "../lib/catalog"

interface Props {
  curso: Pick<CursoPublicado, "slug" | "rutas">
  variant?: "hero" | "lesson"
  leccion?: { numero: string; variante: string; entorno: string; arranque: string }
}

const { curso, variant = "hero", leccion } = Astro.props
const rutas = curso.rutas
const uid = (eje: string) => `${curso.slug}-${eje}`
// Solo la lección emite data-lesson-*: sin ellos no hay atenuación (la ficha no pasa el prop).
const leccionAttrs =
  variant === "lesson" && leccion
    ? {
        "data-lesson-numero": leccion.numero,
        "data-lesson-variante": leccion.variante,
        "data-lesson-entorno": leccion.entorno,
        "data-lesson-arranque": leccion.arranque,
      }
    : {}
---

{rutas && (
  <div
    class:list={["course-config", `course-config--${variant}`]}
    data-course-config
    data-slug={curso.slug}
    data-rutas={JSON.stringify(rutas)}
    data-default={JSON.stringify(CONFIG_POR_DEFECTO)}
    {...leccionAttrs}
  >
    <div class="course-config__head">
      <p class="course-config__kicker">Tu ruta</p>
      <p class="course-config__summary" data-config-summary aria-live="polite">
        Fácil · Hardware · Solo Linux
      </p>
    </div>

    <fieldset class="course-config__group" data-config-difficulty>
      <legend>Dificultad</legend>
      <label class="config-option">
        <input type="radio" name={uid("dificultad")} value="facil" checked />
        <span class="config-option__body">
          <span class="config-option__title">Fácil</span>
          <small>archinstall · instalador guiado</small>
        </span>
      </label>
      <label class="config-option">
        <input type="radio" name={uid("dificultad")} value="avanzada" />
        <span class="config-option__body">
          <span class="config-option__title">Avanzada</span>
          <small>Instalación manual paso a paso</small>
        </span>
      </label>
    </fieldset>

    <fieldset class="course-config__group" data-config-environment>
      <legend>Entorno</legend>
      <label class="config-option">
        <input type="radio" name={uid("entorno")} value="vm" />
        <span class="config-option__body">
          <span class="config-option__title">Máquina virtual</span>
          <small>Sin riesgo, sin tocar tu PC</small>
        </span>
      </label>
      <label class="config-option">
        <input type="radio" name={uid("entorno")} value="hardware" checked />
        <span class="config-option__body">
          <span class="config-option__title">Hardware real</span>
          <small>Tu PC · instalación de verdad</small>
        </span>
      </label>
    </fieldset>

    <fieldset class="course-config__group" data-config-boot>
      <legend>Arranque</legend>
      <label class="config-option">
        <input type="radio" name={uid("arranque")} value="solo" checked />
        <span class="config-option__body">
          <span class="config-option__title">Solo Linux</span>
          <small>Arch es el único sistema</small>
        </span>
      </label>
      <label class="config-option">
        <input type="radio" name={uid("arranque")} value="dualboot" />
        <span class="config-option__body">
          <span class="config-option__title">Dual boot</span>
          <small>Conserva Windows junto a Arch</small>
        </span>
      </label>
    </fieldset>
  </div>
)}

<style>
  .course-config {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem 1rem;
    align-items: start;
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--bg-card);
    --hud-cut: 6px;
  }

  .course-config__head {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .course-config__kicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .course-config__summary {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }

  .course-config__group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .course-config__group[data-config-difficulty] {
    --config-eje: var(--signal);
  }

  .course-config__group[data-config-environment],
  .course-config__group[data-config-boot] {
    --config-eje: var(--accent);
  }

  .course-config__group legend {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0;
    margin-bottom: 0.35rem;
  }

  .course-config__group[hidden] {
    display: none;
  }

  /* T8g — opción como botón HUD: radio visible + placa con chamfer.
     El eje del grupo define el acento activo (--signal: dificultad, --accent: entorno/arranque). */
  .config-option {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    cursor: pointer;
  }

  .config-option input {
    flex: 0 0 auto;
    width: 0.85rem;
    height: 0.85rem;
    margin: 0.22rem 0 0;
    appearance: none;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .config-option input:checked {
    border-color: var(--config-eje, var(--accent));
    background: var(--config-eje, var(--accent));
  }

  .config-option__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    clip-path: polygon(
      0 var(--hud-cut),
      var(--hud-cut) 0,
      calc(100% - var(--hud-cut)) 0,
      100% var(--hud-cut),
      100% calc(100% - var(--hud-cut)),
      calc(100% - var(--hud-cut)) 100%,
      var(--hud-cut) 100%,
      0 calc(100% - var(--hud-cut))
    );
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .config-option__body:hover {
    border-color: var(--line-strong);
    background: var(--bg-raised);
  }

  .config-option__title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-dim);
  }

  .config-option__body small {
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .config-option input:checked + .config-option__body {
    border-color: var(--config-eje, var(--accent));
    background: color-mix(in srgb, var(--config-eje, var(--accent)) 10%, transparent);
  }

  .config-option input:checked + .config-option__body .config-option__title {
    color: var(--config-eje, var(--accent));
  }

  .config-option input:focus-visible + .config-option__body {
    outline: 2px solid var(--config-eje, var(--accent));
    outline-offset: 2px;
  }

  .config-option.is-locked {
    cursor: not-allowed;
  }

  .config-option.is-locked input {
    pointer-events: none;
  }

  .config-option.is-locked .config-option__body {
    opacity: 0.38;
    filter: grayscale(0.6);
    border-style: dashed;
  }

  .config-option.is-locked .config-option__body::after {
    content: "🔒";
    position: absolute;
    top: 0.45rem;
    right: 0.5rem;
    font-size: 0.68rem;
    opacity: 0.8;
  }

  .config-option.is-locked .config-option__body small {
    color: inherit;
  }

  .course-config--lesson {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem 0.5rem;
    margin-top: 0;
    padding: 0.55rem;
    --hud-cut: 3px;
  }

  .course-config--lesson .course-config__head {
    padding-bottom: 0.35rem;
  }

  .course-config--lesson .course-config__group {
    gap: 0.25rem;
  }

  .course-config--lesson .course-config__group legend {
    margin-bottom: 0.2rem;
  }

  .course-config--lesson .config-option__body {
    padding: 0.3rem 0.4rem;
  }

  .course-config--lesson .config-option__title {
    font-size: 0.72rem;
  }

  .course-config--lesson .config-option__body small {
    display: none;
  }

  @media (max-width: 640px) {
    .course-config--lesson {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .course-config {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

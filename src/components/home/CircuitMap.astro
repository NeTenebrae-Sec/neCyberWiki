---
import type { CategoriaModulo } from "../../data/categorias"

interface Props {
  categorias: CategoriaModulo[]
}

const { categorias } = Astro.props
---

<div class="board" aria-label="Mapa de sectores">
  <div class="board__grid">
    {categorias.map((categoria) => (
      <button
        type="button"
        class="board-node"
        data-board-target={`mod-${categoria.indice}`}
        aria-controls={`mod-${categoria.indice}`}
        aria-expanded="false"
        data-state={categoria.estado}
      >
        <span class="board-node__index">{categoria.indice}</span>
        <span class="board-node__title">{categoria.titulo}</span>
        <span class="board-node__meta">
          {categoria.nivel} · {categoria.recursos.length} entradas
        </span>
      </button>
    ))}
  </div>
</div>

---
import type { SerieConNotas } from "../lib/catalog"
import { site } from "../data/site"

interface Props {
  serie: SerieConNotas
}

const { serie } = Astro.props
const base = site.base
const serieUrl = `${base}notas/${serie.slug}/`
const titleId = `serie-${serie.slug}-title`
---

<article class="series-card sheet sheet--cut" aria-labelledby={titleId}>
  <span class="series-card__spine" aria-hidden="true" />

  <div class="series-card__head">
    <span class="docket">Serie de notas</span>
    <span class="chip">
      {serie.notas} {serie.notas === 1 ? "nivel" : "niveles"}
    </span>
  </div>

  <h3 class="series-card__title" id={titleId}>
    <a href={serieUrl}>{serie.titulo}</a>
  </h3>
  <p class="series-card__desc">{serie.descripcion}</p>

  <p class="series-card__meta">
    {serie.plataforma} · {serie.nivel} · Linux y SSH
  </p>

  <div class="series-card__actions">
    <a class="btn btn-secondary" href={serieUrl}>
      Ver la serie <span aria-hidden="true">→</span>
    </a>
    <a class="series-card__external" href={serie.url} target="_blank" rel="noopener">
      Sitio oficial <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .series-card {
    --sheet-cut: 24px;
    position: relative;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-paper);
  }

  .series-card__spine {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(var(--blog), color-mix(in srgb, var(--blog) 15%, transparent));
  }

  .series-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.7rem;
  }

  .series-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .series-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .series-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .series-card__desc {
    margin-top: 0.65rem;
    color: var(--ink-dim);
    line-height: 1.65;
  }

  .series-card__meta {
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .series-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
  }

  .series-card__external {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }

  .series-card__external:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>

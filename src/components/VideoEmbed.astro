---
interface Props {
  video: string // YouTube ID or URL; empty = placeholder
  titulo: string
}
const { video, titulo } = Astro.props

let src = ""
if (video) {
  if (/^https?:\/\//.test(video)) {
    // Full URL: force nocookie when it is YouTube.
    const m = video.match(/(?:embed\/|v=|youtu\.be\/)([\w-]{11})/)
    src = m ? `https://www.youtube-nocookie.com/embed/${m[1]}` : video
  } else {
    src = `https://www.youtube-nocookie.com/embed/${video}`
  }
  // enablejsapi lets the chapter list seek with postMessage.
  src += (src.includes("?") ? "&" : "?") + "enablejsapi=1&rel=0"
}
---

{src ? (
  <div class="video-embed">
    <iframe
      id="lesson-video"
      src={src}
      title={`Video: ${titulo}`}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>
  </div>
) : (
  <div class="video-embed video-embed--empty">
    <div class="video-embed__placeholder">
      <svg width="46" height="46" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke="var(--accent)" stroke-width="1.2" opacity="0.6" />
        <path d="M10.2 8.6v6.8l5.9-3.4-5.9-3.4z" fill="var(--accent)" opacity="0.8" />
      </svg>
      <p class="video-embed__label">Video en preparación</p>
      <p class="video-embed__note">
        La guía escrita completa está abajo. El video se publicará cuando esté listo.
      </p>
    </div>
  </div>
)}

<style>
  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: var(--bg-deep);
  }

  .video-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-embed--empty {
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--line);
    background-image:
      radial-gradient(circle at 1px 1px, var(--line) 0.8px, transparent 0.9px),
      linear-gradient(135deg, var(--bg-deep), var(--bg-sunken));
    background-size:
      18px 18px,
      100% 100%;
  }

  .video-embed__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    max-width: 34ch;
    padding: 1.5rem;
    text-align: center;
  }

  .video-embed__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .video-embed__note {
    color: var(--ink-dim);
    font-size: 0.8rem;
    line-height: 1.6;
  }
</style>

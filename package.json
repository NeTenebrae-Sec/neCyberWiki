{
  "name": "necyberwiki",
  "type": "module",
  "version": "1.1.3",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "predev": "astro build && pagefind --site dist --output-path public/pagefind",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "import:bandit": "node scripts/import-bandit.mjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0"
  }
}
